---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wheel from '../components/Wheel.astro';
import Estimator from '../components/Estimator.astro';
import { all } from '../data/projects.js';

/**
 * Four sections: the claim, the wheel, the estimator, the ask.
 *
 * The hero is a sentence and nothing else — no diagram beside it, because
 * the wheel immediately below is the thing that argues the case, and putting
 * a second graphic above it would split the attention it needs.
 */

const description =
  "I build the whole thing for new and growing businesses — the website, the software behind it and the hosting it runs on, designed and deployed by one person in Greater Manchester.";
---

<BaseLayout title="Websites, apps and the software behind them" description={description} wide={true}>

  {/* ---- the claim --------------------------------------------------- */}
  <section class="shell hero">
    <p class="eyebrow rv">Greater Manchester · one person, end to end</p>
    <h1 class="rv">I build the <em>whole</em> thing.</h1>
    <p class="hero-sub rv">
      The website you see, the software behind it, and the hosting it runs on.
      Most people only sell you the first one.
    </p>
    <div class="hero-do rv">
      <a class="btn" href="https://wa.me/447404901859" target="_blank" rel="noopener">Message me on WhatsApp</a>
      <a class="btn btn-ghost" href="#price">Price up a build</a>
    </div>
    <p class="hero-cue rv" aria-hidden="true">Scroll — the work turns</p>
  </section>

  {/* ---- the wheel --------------------------------------------------- */}
  <Wheel items={all} />

  {/* ---- price it ---------------------------------------------------- */}
  <section id="price" class="band">
    <div class="shell">
      <p class="eyebrow rv">Build your stack · rough figure, no email required</p>
      <h2 class="band-h rv">What would yours cost?</h2>
      <div class="rv"><Estimator /></div>
    </div>
  </section>

  {/* ---- the ask ----------------------------------------------------- */}
  <section class="shell ask">
    <h2 class="ask-h rv">Tell me what you need.</h2>
    <p class="ask-p rv">
      I'll tell you what it takes and what it costs, usually the same day. No
      obligation, and I'll say so if I'm not the right fit for it.
    </p>
    <div class="hero-do rv">
      <a class="btn" href="https://wa.me/447404901859" target="_blank" rel="noopener">Message me on WhatsApp</a>
      <a class="btn btn-ghost" href="tel:+447404901859">07404 901859</a>
    </div>
  </section>

</BaseLayout>

<style>
  .hero { padding-block: clamp(56px, 11vh, 118px) clamp(40px, 8vh, 84px); }

  .hero h1 {
    font-size: clamp(2.9rem, 8.4vw, 6.2rem);
    margin: 20px 0 0;
    max-width: 15ch;
  }
  /* The one word the sentence turns on. Sand is used exactly here, on the
     wheel's active card, and on the primary button — three places, one job. */
  .hero h1 em { font-style: normal; color: var(--color-blue); }

  .hero-sub {
    margin: 30px 0 0;
    max-width: 46ch;
    font-size: clamp(1.05rem, 2vw, 1.32rem);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .hero-do { margin-top: 38px; display: flex; flex-wrap: wrap; gap: 14px; }

  .hero-cue {
    margin: clamp(44px, 8vh, 92px) 0 0;
    font-family: var(--font-body);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-ink-2);
    display: flex; align-items: center; gap: 12px;
  }
  .hero-cue::after {
    content: ''; height: 1px; flex: 1; max-width: 190px;
    background: var(--color-line);
  }

  .band { background: var(--color-paper-2); padding-block: clamp(66px, 11vh, 118px); }
  .band-h { font-size: clamp(2rem, 5.2vw, 3.4rem); margin: 16px 0 40px; }

  .ask { padding-block: clamp(70px, 12vh, 130px); }
  .ask-h { font-size: clamp(2.2rem, 6.4vw, 4.4rem); margin: 0; }
  .ask-p { margin: 24px 0 0; max-width: 50ch; color: var(--color-ink-2); font-size: 1.05rem; }
</style>
