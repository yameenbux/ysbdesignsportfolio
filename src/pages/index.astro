---
import BaseLayout from '../layouts/BaseLayout.astro';
import LayerRig from '../components/LayerRig.astro';
import Estimator from '../components/Estimator.astro';
import { lead } from '../data/projects.js';

const description =
  "I help new and growing businesses look established online — the website, the software behind it and the hosting it runs on, built and deployed end to end.";
---

<BaseLayout title="Websites, apps and the software behind them" description={description}>

  {/* ---- hero: the claim, and the stack it describes ------------------ */}
  <section class="grid grid-cols-1 gap-11 pt-16 pb-10 md:grid-cols-[1.05fr_0.95fr] md:items-center md:gap-14">
    <div>
      <p class="label m-0 mb-5">Greater Manchester · one person, end to end</p>
      <h1 class="text-[clamp(2.6rem,6.2vw,4.6rem)] font-extrabold leading-[0.98] tracking-[-0.03em] [font-variation-settings:'wdth'_112]">
        Three layers
        <span class="block font-medium text-ink-2 [font-variation-settings:'wdth'_88]">under every site I build.</span>
      </h1>
      <p class="mt-6 max-w-[46ch] text-ink-2">
        The website you see, the software behind it, and the hosting it runs
        on. Most people only sell you the first one. Pull the stack apart and
        have a look.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a class="btn" href="#build">Price up a build</a>
        <a class="btn btn-ghost" href="/work.html">See the work</a>
      </div>
    </div>

    <LayerRig shot={lead[0].img} shotAlt={lead[0].alt} />
  </section>

  {/* ---- work -------------------------------------------------------- */}
  <section class="border-t border-line py-24">
    <div class="rv mb-13 flex items-baseline justify-between gap-5">
      <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Things I have actually shipped</h2>
      <a href="/work.html" class="label no-underline transition-colors duration-150 hover:text-blue">All work →</a>
    </div>

    {lead.map((p) => (
      <article class="rv grid grid-cols-1 gap-6 border-t border-line py-9 lg:grid-cols-[200px_1fr_300px] lg:items-start lg:gap-9">
        <div>
          <p class="label label-blue m-0">{p.kind}</p>
          <p class="label m-0 mt-1.5">{p.where}</p>
        </div>

        <div>
          <h3 class="text-[1.55rem] font-bold tracking-[-0.02em]">
            <a href={p.href} class="group inline-flex items-baseline gap-2 no-underline transition-colors duration-150 hover:text-blue">
              {p.name}
              <span aria-hidden="true" class="text-ink-2 transition-transform duration-150 group-hover:translate-x-[3px] group-hover:text-blue">→</span>
            </a>
          </h3>
          <p class="mt-2.5 max-w-[52ch] text-ink-2">{p.outcome}</p>

          {/* which of the three layers this project actually needed */}
          <div class="mt-4 flex flex-col gap-1.5">
            {[['Interface', p.layers.interface], ['Software', p.layers.software], ['Infrastructure', p.layers.infra]].map(([name, w]) => (
              <div class="label m-0 flex items-center gap-2.5">
                <i class="layer-bar block h-1.5 bg-blue/25" style={`width:${w}%`}></i>{name}
              </div>
            ))}
          </div>
        </div>

        <a href={p.href} class="shot group relative block aspect-[16/10] overflow-hidden border border-line bg-plane">
          <img src={p.img} alt={p.alt} width="760" height="475" loading="lazy" decoding="async"
               class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 group-hover:-translate-y-[4%] group-hover:scale-[1.045]" />
          <span class="absolute right-2.5 top-2.5 flex items-center gap-1.5 border border-line bg-plane/90 px-2 py-1">
            <span class="pulse"></span><span class="label m-0 text-[10px]">Live</span>
          </span>
        </a>
      </article>
    ))}
  </section>

  {/* ---- what I do --------------------------------------------------- */}
  <section class="border-t border-line py-24">
    <h2 class="rv label m-0">What I do</h2>
    {/* The reveal sits on the list, not the rows: a display:contents
        element generates no box, so IntersectionObserver never fires for it
        and the rows would stay invisible for good. */}
    <dl class="rv mt-10 grid grid-cols-1 gap-x-8 gap-y-6 lg:grid-cols-12">
      {[
        ['Sites', 'Marketing sites, one-pagers and shops that load fast and turn up in a search.'],
        ['Apps', 'Booking systems, installable web apps, admin tools — the software a business actually runs on.'],
        ['Behind it', 'Backends, APIs, databases, payments and email.'],
        ['Keeping it up', 'Hosting, domains, deploys and the pipeline that ships changes.'],
      ].map(([term, detail]) => (
        <div class="contents">
          <dt class="label m-0 lg:col-span-3">{term}</dt>
          <dd class="measure m-0 text-ink-2 lg:col-span-9">{detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* ---- estimator --------------------------------------------------- */}
  <section id="build" class="border-t border-line py-24">
    <div class="rv mb-13 flex flex-wrap items-baseline justify-between gap-5">
      <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Build your stack</h2>
      <span class="label">Rough figure · no email required</span>
    </div>
    <div class="rv"><Estimator /></div>
  </section>

  {/* ---- contact ----------------------------------------------------- */}
  <section class="border-t border-line py-24">
    <h2 class="rv text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Tell me what you need</h2>
    <p class="rv measure mt-6 text-ink-2">
      I'll tell you what it takes and what it costs, usually the same day. No
      obligation, and I'll say so if I'm not the right fit for it.
    </p>
    <div class="rv mt-8 flex flex-wrap items-center gap-3.5">
      <a class="btn" href="https://wa.me/447404901859" target="_blank" rel="noopener">Message me on WhatsApp</a>
      <a class="btn btn-ghost" href="tel:+447404901859">07404 901859</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hovering a project brightens its layer read-out. This was in the approved
     treatment and got dropped when the bars were rebuilt as utilities. */
  .layer-bar { transition: opacity 0.3s var(--ease-draft), width 0.9s var(--ease-draft); }
  article:hover .layer-bar { opacity: 0.62; }
  @media (prefers-reduced-motion: reduce) { .layer-bar { transition: none; } }
</style>
