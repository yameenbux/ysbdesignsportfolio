---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Homepage. Section order is fixed by CLAUDE.md, "## Structure":
 * positioning, selected work, what I do, about, contact.
 *
 * Evidence sits above biography deliberately — the work is what convinces,
 * so it comes before anything about Yameen.
 */

// The three that lead. Outcome lines are drawn from each case study's own
// copy; nothing here is a metric, a rating or a client count.
const work = [
  {
    href: '/taiyabah.html',
    name: 'Taiyabah Masjid',
    kind: 'Community project',
    stack: 'PWA · Website · Signage · Serverless backend',
    outcome:
      'Prayer times in front of a Bolton community every day. One system feeds a phone app, a public website, two always-on screens in the building and a home display for a spare tablet or TV.',
    img: '/assets/img/taiyabah-web.jpg',
    alt: 'The Taiyabah Masjid website',
  },
  {
    href: '/venetian.html',
    name: 'The Venetian Company',
    kind: 'Client',
    stack: 'Website · Identity · Design → build → deploy',
    outcome:
      'Venetian plaster and microcement work that lived entirely on Instagram — nothing to send anyone, nothing that turned up in a search. Now a site on their own domain, art-directed around their own photography.',
    img: '/assets/img/venetian-web.jpg',
    alt: 'The Venetian Company website',
  },
  {
    href: '/hairbychrissy.html',
    name: 'Hair by Chrissy',
    kind: 'Client',
    stack: 'Booking platform · Front end · Backend · Payments',
    outcome:
      'Bookings arrived as Instagram DMs, with no calendar and no way to stop two people asking for the same Saturday. The site is the booking system: live availability, deposits, and a real calendar behind it.',
    img: '/assets/img/hbc-web.jpg',
    alt: 'The Hair by Chrissy booking site',
  },
];

const capabilities = [
  ['Sites', 'Marketing sites, one-pagers and shops that load fast and turn up in a search.'],
  ['Apps', 'Booking systems, installable web apps, admin tools — the software a business actually runs on.'],
  ['Behind it', 'Backends, APIs, databases, payments and email.'],
  ['Keeping it up', 'Hosting, domains, deploys and the pipeline that ships changes.'],
];

const WHATSAPP = 'https://wa.me/447404901859';
const TEL = '+447404901859';
const LINKEDIN = 'https://www.linkedin.com/in/yameenbux';

const description =
  "I help new and growing businesses look established online — the website, the software behind it and the hosting it runs on, built and deployed end to end.";
---

<BaseLayout title="Websites, apps and the software behind them" description={description}>
  {/* 1 — Positioning. The claim is the first thing on the page. */}
  <section>
    <p class="label">Greater Manchester · working anywhere</p>
    <h1
      class="measure mt-5 text-[clamp(2rem,4vw,3rem)] font-semibold leading-[1.15] tracking-[-0.015em]"
    >
      I help new and growing businesses look established online.
    </h1>
    <p class="measure mt-6 text-[17px] leading-[1.6] text-muted">
      The website, the software behind it and the hosting it runs on, built and
      deployed end to end — so you can point people at something you're proud of.
    </p>
  </section>

  {/* 2 — Selected work. Rules separate the entries; no cards, no shadows. */}
  <section class="mt-20 border-t border-rule pt-3">
    <h2 class="label m-0">Selected work</h2>

    <ul class="mt-10 list-none space-y-16 p-0">
      {work.map((w) => (
        <li class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8">
          {/* the narrow metadata column — documentation layout, not marketing */}
          <div class="md:col-span-3">
            <p class="label m-0">{w.kind}</p>
            <p class="label m-0 mt-2 normal-case tracking-normal">{w.stack}</p>
          </div>

          <div class="md:col-span-9">
            <h3 class="m-0 text-[21px] font-semibold tracking-[-0.01em]">
              <a
                href={w.href}
                class="group inline-flex items-baseline gap-2 no-underline transition-colors duration-150 ease-out hover:text-accent"
              >
                {w.name}
                <span
                  aria-hidden="true"
                  class="text-muted transition-transform duration-150 ease-out group-hover:translate-x-[3px] group-hover:text-accent"
                >→</span>
              </a>
            </h3>

            <p class="measure mt-3 text-[17px] leading-[1.6] text-muted">{w.outcome}</p>

            <a href={w.href} class="mt-6 block" tabindex="-1" aria-hidden="true">
              <img
                src={w.img}
                alt={w.alt}
                width="760"
                height="475"
                loading="lazy"
                decoding="async"
                class="w-full border border-rule"
              />
            </a>
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-12">
      <a
        href="/work.html"
        class="label text-ink underline decoration-rule underline-offset-4 transition-colors duration-150 ease-out hover:text-accent hover:decoration-accent"
      >
        All work →
      </a>
    </p>
  </section>

  {/* 3 — What I do. A list, not a services grid. No icons. */}
  <section class="mt-20 border-t border-rule pt-3">
    <h2 class="label m-0">What I do</h2>

    <dl class="mt-10 grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-12">
      {capabilities.map(([term, detail]) => (
        <div class="contents">
          <dt class="label m-0 md:col-span-3">{term}</dt>
          <dd class="measure m-0 text-[17px] leading-[1.6] text-muted md:col-span-9">{detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* 4 — About, compressed. Content sits in the same 9 columns as the work
      and capability sections, so the page keeps one content edge throughout. */}
  <section class="mt-20 border-t border-rule pt-3">
    <h2 class="label m-0">Who you'd be working with</h2>

    <div class="mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-12">
      <div class="md:col-span-9 md:col-start-4">
        <p class="measure m-0 text-[17px] leading-[1.6]">
          I'm Yameen. I do the whole thing myself — the design, the code, the
          database behind it and the cloud it runs on — so there's no agency
          layer between you and the person building your site.
        </p>
        <p class="measure mt-4 text-[17px] leading-[1.6] text-muted">
          That means one person to ask, and one person who knows why every
          decision was made.
        </p>
        <p class="mt-6">
          <a
            href="/about.html"
            class="label text-ink underline decoration-rule underline-offset-4 transition-colors duration-150 ease-out hover:text-accent hover:decoration-accent"
          >
            More about how I work →
          </a>
        </p>
      </div>
    </div>
  </section>

  {/* 5 — Contact. WhatsApp is the primary action. */}
  <section class="mt-20 border-t border-rule pt-3">
    <h2 class="label m-0">Start something</h2>

    <div class="mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-12">
      <div class="md:col-span-9 md:col-start-4">
        <p class="measure m-0 text-[17px] leading-[1.6]">
          Tell me what you need and I'll tell you what it takes. No obligation,
          and I'll say so if I'm not the right fit.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href={WHATSAPP}
            target="_blank"
            rel="noopener"
            class="border border-accent px-5 py-3 text-[15px] font-medium text-accent no-underline transition-colors duration-150 ease-out hover:bg-accent hover:text-bg"
            style="border-radius: var(--radius-sm)"
          >
            Message me on WhatsApp
          </a>

          <a
            class="label transition-colors duration-150 ease-out hover:text-accent"
            href={`tel:${TEL}`}
          >
            Call 07404 901859
          </a>

          <a
            class="label transition-colors duration-150 ease-out hover:text-accent"
            href={LINKEDIN}
            target="_blank"
            rel="noopener"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
