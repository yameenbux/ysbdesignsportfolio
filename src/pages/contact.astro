---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Contact. WhatsApp-first, no form — confirmed rather than assumed.
 *
 * Static hosting has no server, so a form would need a third-party endpoint.
 * The spec's position is that WhatsApp converts better for this audience
 * anyway, and a form nobody uses is worse than no form.
 *
 * No email address here. There is no mailbox, and publishing one that
 * bounces is worse than publishing none (CLAUDE.md, "## Contact"). The
 * off-site profile link was removed at the user's request, so WhatsApp and
 * the phone number are now the only two routes on the site.
 */

const WHATSAPP = 'https://wa.me/447404901859';
const TEL = '+447404901859';

// What makes a first message answerable in one reply rather than four.
const helpful = [
  ['What you do', 'The business, and who your customers are.'],
  ['What you need', "A site, a booking system, something that talks to software you already use — or just the problem, if you're not sure what fixes it."],
  ['When', 'A date you need it by, if you have one.'],
];

const description =
  "Message me on WhatsApp and I'll tell you what it takes — usually the same day. No form, no obligation.";
---

<BaseLayout title="Contact" description={description}>
  <section class="pt-16">
    <p class="label m-0">Contact</p>
    <h1 class="mt-5 text-[clamp(2.4rem,5.6vw,4rem)] font-extrabold leading-[1] tracking-[-0.03em] [font-variation-settings:'wdth'_112]">
      Tell me what you need.
    </h1>
    <p class="measure mt-6 text-[17px] leading-[1.6] text-ink-2">
      I'll tell you what it takes and what it costs, usually the same day.
      No obligation, and I'll say so if I'm not the right fit for it.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href={WHATSAPP}
        target="_blank"
        rel="noopener"
        class="btn"
      >
        Message me on WhatsApp
      </a>
      <a class="label transition-colors duration-150 ease-out hover:text-blue" href={`tel:${TEL}`}>
        Call 07404 901859
      </a>
    </div>
  </section>

  <section class="border-t border-line py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Worth putting in the first message</h2>

    <dl class="rv mt-10 grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-12">
      {helpful.map(([term, detail]) => (
        <div class="contents">
          <dt class="label m-0 md:col-span-3">{term}</dt>
          <dd class="measure m-0 text-[17px] leading-[1.6] text-ink-2 md:col-span-9">{detail}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-12">
      <p class="measure m-0 text-[17px] leading-[1.6] text-ink-2 md:col-span-9 md:col-start-4">
        None of it is required. "I need a website for my shop" is a fine place
        to start.
      </p>
    </div>
  </section>
  {/* Was "Where and how", a two-row list whose second row was an off-site
      profile link. With that route removed there is one fact left, and a
      definition list of one term reads as a list with something missing. */}
  <section class="border-t border-line py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Where I work from</h2>

    <div class="rv mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-12">
      <p class="measure m-0 text-[17px] leading-[1.6] text-ink-2 md:col-span-9 md:col-start-4">
        Greater Manchester. The work has gone to London, Birmingham, Coventry
        and Nuneaton, so where you are is not the deciding factor.
      </p>
    </div>
  </section>
</BaseLayout>
