---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lead } from '../data/projects.js';

/**
 * Two groups, because they are not the same claim. Work done for someone else
 * is evidence that people hire me and I deliver; a product I own is evidence
 * of something else entirely, and mixing them lets the second dilute the
 * first for a visitor scanning for the first.
 *
 * The first group is "client and community", not "client" — Taiyabah is
 * community work and filing it under clients would imply a commission that
 * never happened. Each entry still carries its own kind.
 */
const groups = [
  {
    id: 'for-others',
    title: 'Built for other people',
    blurb: 'Paid client work, and one community project.',
    items: lead.filter((p) => !p.product),
  },
  {
    id: 'products',
    title: 'Built for myself',
    blurb: 'Products I own rather than work I was asked to do.',
    items: lead.filter((p) => p.product),
  },
].filter((g) => g.items.length);

const description =
  'Client and community work written up as problem, approach and outcome, and the products built alongside it.';
---

<BaseLayout title="Work" description={description}>
  <section class="pt-16 pb-4">
    <p class="label m-0">{lead.length} projects · {groups.length} kinds</p>
    <h1 class="mt-5 text-[clamp(2.4rem,5.6vw,4rem)] font-extrabold leading-[1] tracking-[-0.03em] [font-variation-settings:'wdth'_112]">
      Work
    </h1>
    <p class="measure mt-6 text-ink-2">
      What the problem was, what I built, and which of the three layers it
      actually needed. Each one links to the full case study with the screens.
    </p>
  </section>

  {groups.map((g) => (
    <>
      <section class="border-t border-line pt-16" aria-labelledby={g.id}>
        <h2 id={g.id} class="rv text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">{g.title}</h2>
        <p class="rv measure mt-4 text-ink-2">{g.blurb}</p>
      </section>

      {g.items.map((p) => (
    <section class="py-20">
      <p class="rv label label-blue m-0">{p.kind} · {p.where}</p>

      <div class="mt-9 grid grid-cols-1 gap-7 lg:grid-cols-12 lg:gap-9">
        <aside class="rv lg:col-span-3">
          <p class="label m-0 normal-case tracking-normal">{p.stack}</p>
          <div class="mt-6 flex flex-col gap-1.5">
            {[['Interface', p.layers.interface], ['Software', p.layers.software], ['Infrastructure', p.layers.infra]].map(([name, w]) => (
              <div class="label m-0 flex items-center gap-2.5">
                <i class="block h-1.5 bg-blue/25" style={`width:${w}%`}></i>{name}
              </div>
            ))}
          </div>
        </aside>

        <div class="lg:col-span-9">
          <h3 class="rv text-[clamp(1.6rem,3.4vw,2.2rem)] font-bold tracking-[-0.025em]">
            <a href={p.href} class="group inline-flex items-baseline gap-2 no-underline transition-colors duration-150 hover:text-blue">
              {p.name}
              <span aria-hidden="true" class="text-[17px] text-ink-2 transition-transform duration-150 group-hover:translate-x-[3px] group-hover:text-blue">→</span>
            </a>
          </h3>

          <dl class="rv mt-7 space-y-6">
            {[['Problem', p.problem], ['Approach', p.approach], ['Outcome', p.outcome]].map(([k, v]) => (
              <div>
                <dt class="label m-0">{k}</dt>
                <dd class="measure m-0 mt-2 text-ink-2">{v}</dd>
              </div>
            ))}
          </dl>

          <a href={p.href} class="rv group mt-8 block overflow-hidden border border-line bg-plane">
            <img src={p.img} alt={p.alt} width="760" height="475" loading="lazy" decoding="async"
                 class="block h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]" />
          </a>

          <p class="rv mt-6">
            <a href={p.href} class="label label-ink underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-blue hover:decoration-blue">
              Read the {p.name} case study →
            </a>
          </p>
        </div>
      </div>
    </section>
      ))}
    </>
  ))}

  <section class="border-t border-line py-24">
    <h2 class="rv text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Sound like your problem?</h2>
    <p class="rv measure mt-6 text-ink-2">Tell me about it and I'll tell you what it takes.</p>
    <div class="rv mt-8 flex flex-wrap items-center gap-3.5">
      <a class="btn" href="https://wa.me/447404901859" target="_blank" rel="noopener">Message me on WhatsApp</a>
      <a class="btn btn-ghost" href="/contact.html">Other ways to reach me</a>
    </div>
  </section>
</BaseLayout>
