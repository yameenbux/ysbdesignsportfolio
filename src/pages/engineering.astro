---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mechanism from '../components/Mechanism.astro';
import { marks } from '../data/stack.js';

/**
 * How I engineer — six principles, each with one thing you can press and one
 * piece of evidence you can open.
 *
 * REWRITTEN IN PHASE 27, and the brief was "way too much text". The previous
 * version carried seven pipeline write-ups, seven data write-ups, a hosting
 * list and five failure essays — perhaps 3,500 words, every one of them true
 * and almost none of them read. That content is not deleted: it is compressed
 * into `proof`, which sits inside a <details> under each principle. The page
 * reads in about ninety seconds; a sceptic can still open every claim and
 * find the file it points at, which is the thing CLAUDE.md's audience note
 * actually requires.
 *
 * Each principle is a real position with a real cost, taken from work in
 * public repositories — not a capability word. "I know CI/CD" is not
 * evidence; a release gate that refuses to build is.
 *
 * Colour: `tone` picks one of the four measured accents. It carries the
 * section's rule, number and mark. See the note in global.css for why these
 * four and no others, and for the one pair that must never be distinguished
 * by colour alone.
 */

const principles = [
  {
    n: '01',
    tone: 'blue',
    title: 'Put the rule where it cannot be argued with',
    line: 'A rule in the app can be got round — by a bug, by another screen, by somebody editing the page in their browser. A rule in the database cannot, because every way in goes through it.',
    cost: 'It is slower to write and harder to change later. That is the trade, and it is worth it for the rules that would be expensive to get wrong.',
    mech: 'race',
    proof: [
      ['Booked In', 'Two phones can take the same 09:00. <code>booking_no_overlap</code> is an <code>EXCLUDE USING gist</code> over the studio and a <code>tstzrange</code>, so the second write raises <code>23P01</code> and rolls back. Cancelled rows sit outside the constraint, so cancelling frees the slot without any code deciding it should.'],
      ['Booked In', 'A treatment needing a patch test cannot be booked by somebody whose test has lapsed — and booking the test <em>is</em> the record, so nothing has to be remembered afterwards.'],
      ['Bolton Vouched', 'A provider row cannot reach <code>live</code> without recorded consent: a <code>CHECK</code> constraint, not a rule in the admin screen. Stored beside the timestamp is a SHA-256 of the exact wording accepted, so <em>what</em> was agreed is provable, not just when.'],
      ['MasjidOne', 'Every table carries a <code>masjid_id</code> that is <code>not null</code> with no default, filled by <code>current_masjid()</code>. A <code>health_check()</code> function asserts it — and caught a table built exactly as its design drawing showed, where the drawing had no tenant column at all.'],
    ],
  },
  {
    n: '02',
    tone: 'rust',
    title: 'A check that cannot fail is worse than no check',
    line: 'A green tick you have not earned buys confidence you should not have. The gates worth building are the ones allowed to say no.',
    cost: 'Gates block you on your own bad days too. Nobody has ever regretted one at 2am.',
    mech: 'gate',
    proof: [
      ['Taiyabah — native-release.yml', 'The Play bundle workflow refuses to run unless that exact commit already has a successful smoke run. It asks the GitHub API for runs at <code>head_sha</code> and exits non-zero when the count is zero.'],
      ['Why it exists', 'Five iOS builds went green having executed none of the project’s code — the job built <code>-configuration Debug</code>, which expects a Metro dev server no runner has. The app launched, stayed alive and wrote no crash report. The screenshots were 72% black and nothing was looking at them.'],
      ['ysbdesignsportfolio — deploy.yml', 'This site’s own build fails if <code>CNAME</code> is missing from the output, because a build that drops it takes the custom domain down while still reporting success.'],
    ],
  },
  {
    n: '03',
    tone: 'green',
    title: 'Trust the source, not your copy of it',
    line: 'A file in your repository says what you intended. The service says what is true. When they disagree, only one of them decides whether the thing works.',
    cost: 'It means one more network call in CI, and a job that can fail for reasons outside your diff.',
    mech: 'truth',
    proof: [
      ['Taiyabah — android-build.yml', 'Before building, the job asks <strong>Google’s Digital Asset Links API</strong> whether the live site actually verifies the app, rather than trusting the <code>assetlinks.json</code> sitting in the repository. Only one of the two decides whether a store install opens without a browser bar.'],
      ['Taiyabah — deploy-worker.yml', 'The notification Worker deploys, and then the job re-requests it and fails if it is not answering. A deploy step exiting zero means the upload worked, not that the thing is up.'],
      ['Across two repositories', 'CI asserts the native app and the website agree — on copy, on where every link points, and on colour. Two surfaces describing the same masjid differently is a bug nobody catches by hand.'],
    ],
  },
  {
    n: '04',
    tone: 'mag',
    title: 'Closed by default, including things that do not exist yet',
    line: 'Permissions granted by remembering get forgotten. Start shut, open one door deliberately, and a table added next year starts shut too.',
    cost: 'You will lock yourself out at least once while building it.',
    mech: 'tenancy',
    proof: [
      ['Taiyabah', 'The imam’s advice table has Row Level Security on and <strong>no policies at all</strong>, with every grant revoked. No policy means no row passes; the only way in is a function that checks the role itself — and it deliberately does not fall back to administrator, because somebody writing to the imam in confidence is not writing to the committee.'],
      ['Bolton Vouched', 'The anonymous role is stripped of every grant and <strong>default privileges are revoked too</strong>, so a table added next year starts closed. One view is the only door — and its helpers live in a schema the public cannot reach, because Postgres checks function permissions against the <em>calling</em> role even inside a view.'],
      ['Tidemark — Pages build', 'The job that runs <code>npm ci</code>, and so every dependency’s install scripts, holds <code>contents: read</code> and nothing else. Only a separate job holds <code>pages: write</code>, so a compromised postinstall script cannot publish.'],
      ['Booked In — build.sh', 'The publish step will not emit a <code>dist/</code> holding a service-role key. It decodes every JWT it finds and reads the role claim rather than grepping for a phrase, because the two keys look alike and a comment mentioning one is not a leak.'],
    ],
  },
  {
    n: '05',
    tone: 'rust',
    title: 'The screen will tell you it worked',
    line: 'Interfaces report what they were asked to do, not what happened. The worst bugs I have shipped were all reported as successes.',
    cost: 'Distrusting your own tooling is tiring. It is still cheaper than the alternative.',
    mech: 'burst',
    proof: [
      ['Taiyabah — prayer reminders', 'The settings screen said “36 reminders are scheduled on this phone” over an empty queue. The library matches a trigger on its <code>type</code> field and drops anything unrecognised to a <code>null</code> default — and a null trigger does not mean never, it means deliver it now. Every reminder was spent the instant it was set.'],
      ['MasjidOne', 'Features were tagged <em>in development</em> across a product site because their tables were empty. They were complete and enforcing; nobody had used them yet. Months of telling customers that a shipped feature was coming. Zero rows is a usage fact, not a capability fact.'],
      ['A scheduled reconciler', 'Green every five minutes for weeks, purely because nothing was ever queued for it. The first item it resolved raised <code>23502</code> and rolled back everything it had just written. An idle scheduled job is not a passing one.'],
    ],
  },
  {
    n: '06',
    tone: 'blue',
    title: 'Build for the real crowd, not the demo',
    line: 'Limits sized against a room full of people meet a congregation. The failure is silent, and it lands on the one day it matters.',
    cost: 'It means guessing at a population you have not got yet, and sometimes guessing high.',
    mech: 'crowd',
    proof: [
      ['Taiyabah', 'Everyone on the masjid wifi leaves through one public IP, so a per-IP cap counts the whole building as a single caller. The tag-write cap was 600 an hour, set when the note beside it said “high enough that a room full of people never reaches it”.'],
      ['What it would have cost', 'The hour after the app is announced at Jumuʿah is the one hour when every phone writes its tags at once. The 601st person would be refused and left untagged — silently unreachable by every announcement afterwards, holding an app that otherwise works perfectly, with nothing pointing at the cause.'],
      ['The fix', 'An address cap cannot tell a congregation from an attacker; a per-device cap can. The shared-address limits now fit the real population and the per-device cap is the one left with teeth.'],
    ],
  },
];

/**
 * Counted on 16 October, here. The two test figures by running the suites —
 * local stack up, every migration applied, then db-test.sh and vitest — not
 * by summing plan() lines. `how` is what reproduces each one.
 */
const counts = [
  { n: '564', label: 'database tests', how: 'npm run test:db' },
  { n: '329', label: 'unit tests', how: 'npx vitest run' },
  { n: '140', label: 'tracked migrations', how: 'ls db/[0-9]*.sql' },
  { n: '11', label: 'CI workflows', how: 'ls .github/workflows' },
];

const layers = [
  { h: 'What you touch', marks: ['react', 'nextdotjs', 'typescript', 'tailwindcss', 'expo'] },
  { h: 'What builds and ships it', marks: ['github', 'githubactions', 'cloudflareworkers', 'railway', 'render'] },
  { h: 'Where the rules live', marks: ['postgresql', 'supabase', 'stripe'] },
];
---

<BaseLayout
  title="Engineering — how I build and run things"
  description="Six principles I build to, each with something you can press and the public file it points at: rules in the database, gates that refuse, closed by default, and the failures that taught me."
  wide
>
  <svg class="sprite" aria-hidden="true" focusable="false"><defs>
    {Object.entries(marks).map(([k, m]) => (
      <symbol id={`m-${k}`} viewBox="0 0 24 24"><title>{m.title}</title><path d={m.d} /></symbol>
    ))}
  </defs></svg>

  <section class="hero shell">
    <p class="eyebrow m-0 rv">Engineering</p>
    <h1 class="rv">Six things I believe, <span class="h-a">and the files</span> that prove it.</h1>
    <p class="hero-p rv">
      Press anything on this page. Every principle has one thing you can run
      and one piece of evidence you can open, pointing at a public repository.
    </p>
    <ul class="counts rv">
      {counts.map((c) => (
        <li><span class="count-n">{c.n}</span><span class="count-l">{c.label}</span><span class="count-h">{c.how}</span></li>
      ))}
    </ul>
    <p class="counts-note rv">Counted on the day, not read off a badge — the command that reproduces each one is underneath it.</p>
  </section>

  {principles.map((p) => (
    <section class={`pr pr-${p.tone}`} data-pr>
      <div class="pr-in shell">
        <header class="pr-head">
          <span class="pr-n" aria-hidden="true">{p.n}</span>
          <div>
            <h2>{p.title}</h2>
            <p class="pr-line">{p.line}</p>
            <p class="pr-cost"><span class="pr-cost-l">The cost</span> {p.cost}</p>
          </div>
        </header>

        <Mechanism kind={p.mech} />

        <details class="proof">
          <summary><span class="proof-t">Show the evidence</span><span class="proof-c">{p.proof.length} things you can go and read</span></summary>
          <ul class="proof-l">
            {p.proof.map(([where, what]) => (
              <li><span class="proof-w">{where}</span><p set:html={what} /></li>
            ))}
          </ul>
        </details>
      </div>
    </section>
  ))}

  <section class="runs shell">
    <h2 class="rv">What it all runs on</h2>
    <ol class="layers rv">
      {layers.map((L, i) => (
        <li class="layer">
          <span class="layer-n" aria-hidden="true">{i + 1}</span>
          <h3>{L.h}</h3>
          <ul class="layer-m">
            {L.marks.map((k) => (
              <li>
                <svg viewBox="0 0 24 24" width="21" height="21" role="img" aria-label={marks[k].title}><use href={`#m-${k}`} /></svg>
                <span>{marks[k].title}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <p class="runs-note rv">
      <strong>None of this is AWS, Azure or GCP.</strong> The concepts move —
      tenancy, least privilege, build gating, webhook idempotency, deploy
      verification — but I would rather say what I have run than imply a
      console I have not.
    </p>
  </section>

  <section class="ask shell">
    <h2 class="rv">Want to go deeper?</h2>
    <p class="rv ask-p">
      Every repository behind this page is public, and the commit messages
      explain the reasoning rather than the change. Happy to walk through any
      of it.
    </p>
    <div class="rv ask-do">
      <a class="btn" href="/work.html">See the work</a>
      <a class="btn btn-ghost" href="/contact.html">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* ── hero ─────────────────────────────────────────────────────────── */
  .hero { padding-block: 64px 52px; }
  .hero h1 {
    margin: 14px 0 0; max-width: 17ch;
    font-size: clamp(2.6rem, 7.4vw, 5.2rem); line-height: 0.98; letter-spacing: -0.035em;
  }
  .h-a { color: var(--color-blue); }
  .hero-p { margin: 24px 0 0; max-width: 46ch; font-size: 19px; color: var(--color-ink-2); }

  .counts {
    margin: 40px 0 0; padding: 0; list-style: none;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: var(--color-line); border: 1px solid var(--color-line);
    border-radius: var(--radius-sm); overflow: hidden;
  }
  @media (min-width: 720px) { .counts { grid-template-columns: repeat(4, 1fr); } }
  .counts li { display: flex; flex-direction: column; gap: 3px; padding: 18px 16px; background: var(--color-plane); }
  .count-n {
    font-family: var(--font-disp); font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700; line-height: 1; letter-spacing: -0.03em;
  }
  .count-l { font-size: 14px; font-weight: 600; }
  .count-h { margin-top: 5px; font-size: 11.5px; font-weight: 600; color: var(--color-ink-2); }
  .counts-note { margin: 12px 0 0; font-size: 13.5px; color: var(--color-ink-2); }

  /* ── a principle ──────────────────────────────────────────────────────
     Full-bleed colour band, so the page reads as six blocks rather than one
     long column. The rule is 6px of the section's own accent.             */
  .pr { padding: 0; border-top: 6px solid var(--tone); background: var(--color-paper); }
  .pr:nth-child(even) { background: var(--color-paper-2); }
  .pr-in { padding-block: 54px 58px; }
  .pr-blue { --tone: var(--color-blue); }
  .pr-rust { --tone: var(--color-signal); }
  .pr-green { --tone: var(--color-accent-green); }
  .pr-mag { --tone: var(--color-accent-mag); }

  .pr-head { display: grid; gap: 14px; }
  @media (min-width: 760px) { .pr-head { grid-template-columns: auto 1fr; gap: 28px; } }
  .pr-n {
    font-family: var(--font-disp); font-weight: 700; line-height: 0.8;
    font-size: clamp(3.2rem, 9vw, 5.4rem); letter-spacing: -0.04em; color: var(--tone);
  }
  .pr h2 { margin: 0; font-size: clamp(1.7rem, 4.1vw, 2.5rem); letter-spacing: -0.025em; max-width: 20ch; }
  .pr-line { margin: 14px 0 0; max-width: 58ch; font-size: 17.5px; color: var(--color-ink-2); }
  .pr-cost { margin: 16px 0 0; max-width: 58ch; font-size: 15px; color: var(--color-ink-2); }
  .pr-cost-l {
    font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-ink-2); margin-right: 8px;
  }

  /* ── the evidence, folded away ───────────────────────────────────────── */
  .proof { margin: 20px 0 0; border-top: 1px solid var(--color-line); }
  .proof summary {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px;
    padding: 16px 0 0; cursor: pointer; list-style: none;
  }
  .proof summary::-webkit-details-marker { display: none; }
  .proof-t {
    font-family: var(--font-disp); font-size: 15px; font-weight: 600; color: var(--color-ink);
  }
  .proof-t::after {
    content: ' →'; display: inline-block; color: var(--tone);
    transition: transform 200ms var(--ease-turn);
  }
  .proof[open] .proof-t::after { transform: rotate(90deg); }
  .proof-c { font-size: 13px; color: var(--color-ink-2); }
  .proof summary:hover .proof-t { text-decoration: underline; }
  .proof summary:focus-visible { outline: 2px solid var(--tone); outline-offset: 3px; }
  .proof-l { margin: 18px 0 0; padding: 0; list-style: none; display: grid; gap: 16px; }
  .proof-l li {
    display: grid; gap: 6px; padding: 16px 18px;
    background: var(--color-plane); border: 1px solid var(--color-line);
    border-left: 3px solid var(--tone); border-radius: var(--radius-sm);
  }
  .proof-w {
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-ink-2);
  }
  .proof-l p { margin: 0; font-size: 15px; line-height: 1.62; color: var(--color-ink-2); }
  .proof-l strong, .proof-l em { color: var(--color-ink); }

  /* ── what it runs on ──────────────────────────────────────────────────── */
  .runs { padding-block: 64px 20px; }
  .runs h2 { margin: 0 0 26px; font-size: clamp(1.7rem, 4.1vw, 2.5rem); letter-spacing: -0.025em; }
  .layers { margin: 0; padding: 0; list-style: none; display: grid; gap: 14px; }
  @media (min-width: 880px) { .layers { grid-template-columns: repeat(3, 1fr); } }
  .layer {
    padding: 22px 20px; background: var(--color-plane);
    border: 1px solid var(--color-line); border-radius: var(--radius-sm);
  }
  .layer-n {
    display: block; font-family: var(--font-disp); font-size: 13px; font-weight: 700;
    letter-spacing: 0.1em; color: var(--color-ink-2);
  }
  .layer h3 { margin: 6px 0 16px; font-size: 1.05rem; letter-spacing: -0.015em; }
  .layer-m { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 7px; }
  .layer-m li {
    display: flex; align-items: center; gap: 6px; padding: 6px 9px;
    background: var(--color-paper); border: 1px solid var(--color-line);
    border-radius: var(--radius-sm); font-size: 12.5px; font-weight: 600; color: var(--color-ink-2);
  }
  .layer-m svg { flex: none; fill: var(--color-ink-2); }
  .runs-note { margin: 26px 0 0; max-width: 60ch; font-size: 15px; color: var(--color-ink-2); }
  .runs-note strong { color: var(--color-ink); }

  /* ── ask ──────────────────────────────────────────────────────────────── */
  .ask { padding-block: 64px 90px; }
  .ask h2 { margin: 0; font-size: clamp(2rem, 5.4vw, 3.4rem); letter-spacing: -0.03em; }
  .ask-p { margin: 20px 0 0; max-width: 56ch; color: var(--color-ink-2); }
  .ask-do { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 14px; }
</style>
