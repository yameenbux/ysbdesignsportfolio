---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * The candidate page. Until 7 October this carried the freelance process,
 * the price tiers and the pre-booking FAQs; those moved to services.astro
 * when the site pivoted to a hiring audience.
 *
 * No portrait: settled on 5 October, and the decision holds. The page argues
 * with evidence rather than a face.
 *
 * Certifications: the user has some and is sending the list. The slot below
 * is deliberately absent rather than filled with a placeholder — the copy
 * rules bar claiming anything unevidenced, and that includes training.
 */

const build = [
  ['Interfaces', 'Static sites in Astro and Next.js, PWAs with service workers and offline behaviour, and a React Native app. Accessibility checked in CI, not at the end.'],
  ['Software', 'Multi-tenant Postgres on Supabase with row level security, SECURITY DEFINER functions, scheduled jobs and edge functions. Stripe for payments, webhooks included.'],
  ['Delivery', 'GitHub Actions across seven workflows — build, smoke, release gating, worker deploys. Static output to GitHub Pages on custom domains; Cloudflare Workers where compute is unavoidable.'],
];

const how = [
  [
    'The check has to be able to fail',
    'A CI job that cannot catch the thing it exists for is worse than no job, because it buys confidence. I have shipped that mistake and it is the reason my release workflow now refuses to build a bundle no device has opened.',
  ],
  [
    'Write down why, not what',
    'The diff shows what changed. The commit message is for the person who finds this in a year and needs to know which constraint made it the right call — and whether that constraint still holds.',
  ],
  [
    'Say what is not built',
    'Every project here states what is finished, what is staged and what is blocked. Overstating readiness costs more than admitting a gap, and it is the error I have had to correct most often.',
  ],
  [
    'Put the rule where it cannot be bypassed',
    'Hiding a row in the interface is not access control. If it matters, it belongs in the database, behind a grant and a policy — so editing the JavaScript in a browser gets you nothing.',
  ],
];

const description =
  'Yameen — platform and DevOps engineer in Greater Manchester. What I build, how I work, and what I am looking for.';
---

<BaseLayout title="About — platform and DevOps engineer" description={description}>
  <section class="pt-16">
    <p class="label m-0">About</p>
    <h1 class="mt-5 text-[clamp(2.4rem,5.6vw,4rem)] font-extrabold leading-[1] tracking-[-0.03em] [font-variation-settings:'wdth'_112]">
      One person, start to finish.
    </h1>
    <p class="measure mt-6 text-[17px] leading-[1.6] text-ink-2">
      I'm Yameen, in Greater Manchester. I design the interface, model the
      data behind it, write the pipeline that ships it and operate the thing
      once it is live — for a masjid with an app on Google Play, a product of
      my own, and a handful of businesses. Working alone means there is
      nowhere to hand a problem on to, which is the part I have learned most
      from.
    </p>
  </section>

  <section class="border-t border-line py-16 md:py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">What I build</h2>
    <dl class="rv mt-10 grid grid-cols-1 gap-x-8 gap-y-6 lg:grid-cols-12">
      {build.map(([term, detail]) => (
        <div class="contents">
          <dt class="label m-0 lg:col-span-3">{term}</dt>
          <dd class="measure m-0 text-ink-2 lg:col-span-9">{detail}</dd>
        </div>
      ))}
    </dl>
    <p class="measure mt-8 text-[16px] leading-[1.6] text-ink-2">
      The detail, with the workflow files and migrations behind each claim, is
      on <a href="/engineering.html" class="underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-blue hover:decoration-blue">the engineering page</a>.
    </p>
  </section>

  <section class="border-t border-line py-16 md:py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">How I work</h2>

    <dl class="mt-10 space-y-0">
      {how.map(([q, a]) => (
        <div class="rv grid grid-cols-1 gap-x-8 gap-y-3 border-t border-line py-7 md:grid-cols-12">
          <dt class="m-0 text-[19px] font-semibold leading-[1.35] tracking-[-0.01em] md:col-span-5">{q}</dt>
          <dd class="measure m-0 text-[17px] leading-[1.6] text-ink-2 md:col-span-7">{a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="border-t border-line py-16 md:py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">What I'm looking for</h2>

    <div class="rv mt-10 grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-12">
      <p class="label m-0 md:col-span-3">Roles</p>
      <p class="measure m-0 text-[17px] leading-[1.6] text-ink-2 md:col-span-9">
        Platform, DevOps or infrastructure engineering. I am most useful where
        delivery is the problem — pipelines that do not catch what they should,
        environments that drift, deploys nobody trusts.
      </p>

      <p class="label m-0 md:col-span-3">Where</p>
      <p class="measure m-0 text-[17px] leading-[1.6] text-ink-2 md:col-span-9">
        Greater Manchester, or remote. The work above has gone to London,
        Birmingham, Coventry and Nuneaton without me being in the room.
      </p>

      <p class="label m-0 md:col-span-3">Honestly</p>
      <p class="measure m-0 text-[17px] leading-[1.6] text-ink-2 md:col-span-9">
        My production experience is Cloudflare, Supabase, GitHub Actions and
        Render rather than AWS, Azure or GCP. The concepts carry — tenancy,
        least privilege, build gating, webhook idempotency, deploy
        verification — but I would rather be straight about which consoles I
        have actually run things in.
      </p>
    </div>
  </section>

  <section class="border-t border-line py-16 md:py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Get in touch</h2>

    <div class="rv mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-12">
      <div class="md:col-span-9 md:col-start-4">
        <p class="measure m-0 text-[17px] leading-[1.6]">
          Hiring, or want to talk through any of the work above? Either route
          below reaches me.
        </p>
        <p class="measure mt-4 text-[16px] leading-[1.6] text-ink-2">
          Still taking freelance builds alongside this —
          <a href="/services.html" class="underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-blue hover:decoration-blue">process and prices here</a>.
        </p>
        <p class="mt-8">
          <a href="/contact.html" class="btn">Get in touch</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
