---
import BaseLayout from '../layouts/BaseLayout.astro';
import { certs } from '../data/certs.js';

/**
 * The candidate page. Carried the freelance process, prices and FAQs until
 * 7 October; those moved to services.astro with the pivot to a hiring
 * audience.
 *
 * No portrait — settled 5 October and the decision holds.
 *
 * AZ-900 is held. AZ-104 is booked and not sat, and is kept under its own
 * term, in italics, called a plan rather than a qualification. If it is
 * passed, move it up; if it is postponed, take it off.
 */

const build = [
  ['Interfaces', 'Static sites in Astro and Next.js, PWAs with service workers and offline behaviour, and a React Native app. Accessibility checked in CI, not at the end.'],
  ['Software', 'Multi-tenant Postgres on Supabase with row level security, SECURITY DEFINER functions, scheduled jobs and edge functions. Stripe for payments, webhooks included.'],
  ['Delivery', 'GitHub Actions across seven workflows — build, smoke, release gating, worker deploys. Static output to GitHub Pages on custom domains; Cloudflare Workers where compute is unavoidable.'],
];

const how = [
  ['The check has to be able to fail', 'A CI job that cannot catch the thing it exists for is worse than no job, because it buys confidence. I have shipped that mistake, and it is why my release workflow now refuses to build a bundle no device has opened.'],
  ['Write down why, not what', 'The diff shows what changed. The commit message is for whoever finds this in a year and needs to know which constraint made it the right call — and whether that constraint still holds.'],
  ['Say what is not built', 'Every project here states what is finished, what is staged and what is blocked. Overstating readiness costs more than admitting a gap, and it is the error I have had to correct most often.'],
  ['Put the rule where it cannot be bypassed', 'Hiding a row in the interface is not access control. If it matters it belongs in the database, behind a grant and a policy, so editing the JavaScript in a browser gets you nothing.'],
];

const looking = [
  ['Roles', 'Platform, DevOps or infrastructure engineering. I am most useful where delivery is the problem — pipelines that do not catch what they should, environments that drift, deploys nobody trusts.'],
  ['Where', 'Greater Manchester, or remote. The work above has gone to London, Birmingham, Coventry and Nuneaton without me being in the room.'],
  ['Honestly', 'The certificate above is Azure; the systems are not. What I have run in production is Cloudflare, Supabase, GitHub Actions and Render. The concepts carry — tenancy, least privilege, build gating, webhook idempotency, deploy verification — but I would rather be straight about which consoles I have actually operated in than let a fundamentals exam imply more than it is.'],
];

const description =
  'Yameen — platform and DevOps engineer in Greater Manchester. AZ-900 certified. What I build, how I work, and what I am looking for.';
---

<BaseLayout title="About — platform and DevOps engineer" description={description}>
  <section class="head">
    <p class="eyebrow m-0">About</p>
    <h1>One person, start to finish.</h1>
    <p class="head-p">
      I'm Yameen, in Greater Manchester. I design the interface, model the data
      behind it, write the pipeline that ships it and operate the thing once it
      is live — for a masjid with an app on Google Play, a product of my own,
      and a handful of businesses. Working alone means there is nowhere to hand
      a problem on to, which is the part I have learned most from.
    </p>
  </section>

  <section class="sec">
    <h2>What I build</h2>
    <dl class="rows rv">
      {build.map(([term, detail]) => (
        <div class="row">
          <dt class="eyebrow m-0">{term}</dt>
          <dd>{detail}</dd>
        </div>
      ))}
    </dl>
    <p class="sec-p rv">
      The detail, with the workflow files and migrations behind each claim, is
      on <a class="ul-draw ul-draw-on" href="/engineering.html">the engineering page</a>.
    </p>
  </section>

  <section class="sec">
    <h2>Certifications</h2>
    <ul class="certs rv">
      {certs.map((c) => (
        <li class="cert panel">
          {c.badge && (
            <img src={c.badge} alt={`${c.name} badge`} width="96" height="96"
                 loading="lazy" decoding="async" class="cert-badge" />
          )}
          <div>
            <p class="eyebrow m-0">{c.held ? 'Held' : 'Booked'}</p>
            <p class="cert-code">{c.code}</p>
            <p class="cert-name">{c.name}</p>
            {c.note && <p class="cert-note"><em>{c.note}</em></p>}
            {c.verify && (
              <p class="cert-verify">
                <a class="eyebrow ul-draw ul-draw-on" href={c.verify} target="_blank" rel="noopener">Verify ↗</a>
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
    <p class="sec-p rv">
      A fundamentals certificate is not production experience and this page
      does not pretend otherwise — what I have actually run is below.
    </p>
  </section>

  <section class="sec">
    <h2>How I work</h2>
    <dl class="faqs">
      {how.map(([q, a]) => (
        <div class="faq rv">
          <dt>{q}</dt>
          <dd>{a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sec">
    <h2>What I'm looking for</h2>
    <dl class="rows rv">
      {looking.map(([term, detail]) => (
        <div class="row">
          <dt class="eyebrow m-0">{term}</dt>
          <dd>{detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="ask">
    <h2 class="rv">Get in touch</h2>
    <p class="rv ask-p">
      Hiring, or want to talk through any of the work above? Either route below
      reaches me. Still taking freelance builds alongside this —
      <a class="ul-draw ul-draw-on" href="/services.html">process and prices here</a>.
    </p>
    <div class="rv ask-do">
      <a class="btn" href="/contact.html">Get in touch</a>
      <a class="btn btn-ghost" href="/engineering.html">The technical read</a>
    </div>
  </section>
</BaseLayout>

<style>
  .head { padding-block: clamp(40px, 7vh, 74px) 0; }
  .head h1 { font-size: clamp(2.6rem, 8.4vw, 5.4rem); margin: 14px 0 0; max-width: 15ch; }
  .head-p { margin: 26px 0 0; max-width: 56ch; color: var(--color-ink-2); font-size: 1.05rem; }

  .sec { padding-block: clamp(54px, 9vh, 92px) 0; }
  .sec h2 { font-size: clamp(1.9rem, 5vw, 3rem); margin: 0; }
  .sec-p { margin: 20px 0 0; max-width: 54ch; color: var(--color-ink-2); }

  .rows { margin: 30px 0 0; display: grid; gap: 2px; }
  .row {
    display: grid; grid-template-columns: 1fr; gap: 8px;
    padding: 20px 22px;
    background: var(--color-line-2);
    border-radius: var(--radius-sm);
  }
  @media (min-width: 820px) { .row { grid-template-columns: 210px 1fr; gap: 30px; } }
  .row dd, .row p { margin: 0; color: var(--color-ink-2); }
  .row div p + p { margin-top: 14px; }
  .terms-rows { margin-top: 34px; }

  .plans { margin: 32px 0 0; display: grid; gap: 18px; }
  @media (min-width: 900px) { .plans { grid-template-columns: repeat(3, 1fr); } }
  .plan { padding: 26px; display: flex; flex-direction: column; }
  .plan h3 { margin: 0; font-size: 1.35rem; }
  .plan-fig {
    margin: 14px 0 0; font-family: var(--font-disp); font-weight: 800;
    font-size: 2.3rem; line-height: 1; letter-spacing: -0.04em;
  }
  .plan-care { margin: 8px 0 0; }
  .plan-blurb { margin: 16px 0 0; font-size: 15px; line-height: 1.5; }
  .plan ul { margin: 16px 0 0; padding: 0; list-style: none; display: grid; gap: 7px; }
  .plan li {
    font-size: 14.5px; padding-left: 18px; position: relative;
    color: color-mix(in srgb, var(--color-ink) 74%, transparent);
  }
  .plan li::before {
    content: ''; position: absolute; left: 0; top: 9px;
    width: 7px; height: 7px; background: var(--color-blue); border-radius: 50%;
  }

  .certs { margin: 30px 0 0; padding: 0; list-style: none; display: grid; gap: 18px; }
  @media (min-width: 760px) { .certs { grid-template-columns: repeat(2, 1fr); } }
  .cert { padding: 26px; display: flex; align-items: flex-start; gap: 20px; }
  .cert-badge { width: 96px; height: 96px; flex: none; }
  .cert-code {
    margin: 10px 0 0; font-family: var(--font-disp); font-weight: 800;
    font-size: 2rem; line-height: 1; letter-spacing: -0.035em;
  }
  .cert-name { margin: 10px 0 0; color: var(--color-ink-2); font-size: 15.5px; line-height: 1.5; }
  .cert-note { margin: 12px 0 0; color: var(--color-ink-2); font-size: 14.5px; line-height: 1.5; }
  .cert-verify { margin: 12px 0 0; }

  .faqs { margin: 30px 0 0; display: grid; gap: 2px; }
  .faq {
    display: grid; grid-template-columns: 1fr; gap: 8px;
    padding: 22px; background: var(--color-line-2); border-radius: var(--radius-sm);
  }
  @media (min-width: 820px) { .faq { grid-template-columns: 1fr 1.25fr; gap: 34px; } }
  .faq dt { font-family: var(--font-disp); font-weight: 700; font-size: 17px; letter-spacing: -0.015em; line-height: 1.3; }
  .faq dd { margin: 0; color: var(--color-ink-2); font-size: 15.5px; line-height: 1.55; }

  .ask { padding-block: clamp(64px, 11vh, 118px); }
  .ask h2 { font-size: clamp(2rem, 5.4vw, 3.4rem); margin: 0; }
  .ask-p { margin: 20px 0 0; color: var(--color-ink-2); }
  .ask-do { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 14px; }
</style>
