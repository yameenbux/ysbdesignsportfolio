---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * About, with the old services.html content folded in.
 *
 * Carried across verbatim on the numbers: the four steps, the three price
 * tiers and the payment terms are real business terms and not mine to
 * reword. The FAQ likewise — no timescale, client count or result that
 * cannot be evidenced.
 *
 * Deliberately left behind, each for a stated reason: the LuxeScent
 * testimonial (the copy rules bar testimonials), the "Most popular" badge on
 * the Business tier (an unevidenced volume claim), and the YSB Ventures Ltd
 * registration details (removed at the user's request).
 *
 * No portrait: About is built not to want one.
 */

const steps = [
  ['Chat', "Message me on WhatsApp. We talk through what you need and I give you a fixed quote — no obligation."],
  ['Book', 'A 50% deposit books your slot, and I start gathering your content and photos.'],
  ['Build', "I design and build it, share a live preview, and refine it with you until it's right."],
  ['Launch', 'Final balance, we go live, and the care plan keeps it fast, secure and up to date.'],
];

const plans = [
  {
    name: 'Starter',
    build: '£495',
    care: '£20/mo',
    blurb: 'A sharp one-page presence for a small local business.',
    includes: [
      '1–3 page mobile website',
      'WhatsApp and click-to-call buttons',
      'Google Business Profile set up',
      'Hosting, domain and security included',
      'Up to 30 minutes of edits each month',
    ],
  },
  {
    name: 'Business',
    build: '£895',
    care: '£35/mo',
    blurb: 'For businesses that want enquiries, not just a listing.',
    includes: [
      '4–6 page website',
      'Photo gallery and enquiry form',
      'Customer reviews section',
      'Basic local SEO to rank in your area',
      'Up to 1 hour of edits each month',
    ],
  },
  {
    name: 'Premium',
    build: 'from £1,500',
    care: '£55/mo',
    blurb: 'Bigger sites with menus, ordering or content built in.',
    includes: [
      '6+ pages, or a custom build',
      'Menus or online ordering integration',
      'Blog or news section',
      'Ongoing SEO monitoring',
      'Priority support and content updates',
    ],
  },
];

const faqs = [
  [
    'How long does it take?',
    "It depends on the size of the build and how quickly content reaches me — that second one is usually the deciding factor. You get a date in your quote before you pay anything, and I hold to it.",
  ],
  [
    'Do I have to be near Manchester?',
    "No. I'm in Greater Manchester and the work has gone to London, Birmingham, Coventry and Nuneaton. Everything happens over WhatsApp and a shared preview link, so where you are is not the deciding factor.",
  ],
  [
    'I already have a website. Can you fix it rather than replace it?',
    "Sometimes. Send me the address and I'll tell you honestly whether it is worth repairing or whether you'd get more for the money starting again. I'll say so if repairing is the better call.",
  ],
  [
    'Do I have to take the care plan?',
    "The care plan covers hosting, the domain, security updates and your monthly edits, so a site on a plan has somewhere to live. If you'd rather host it yourself, say so at the quote stage and I'll build it to hand over instead.",
  ],
  [
    'Who owns the site when it is finished?',
    "You do, once the final balance is paid — design, content and code, with the domain registered in your name. The terms page spells it out.",
  ],
  [
    'Do you only build websites?',
    "No. Booking systems, installable apps, the backends and databases behind them, and the hosting and deploy pipeline they run on. The prices above cover websites; anything with software behind it is quoted per project.",
  ],
  [
    'What do you need from me to start?',
    "A deposit to book the slot, and your content — text, photos, logo. If the photos are the thing holding you up, tell me early and we work around it rather than letting the project stall.",
  ],
];

const capability = [
  ['Sites', 'Marketing sites, one-pagers and shops that load fast and turn up in a search.'],
  ['Apps', 'Booking systems, installable web apps, admin tools — the software a business actually runs on.'],
  ['Behind it', 'Backends, APIs, databases, payments and email.'],
  ['Keeping it up', 'Hosting, domains, deploys and the pipeline that ships changes.'],
];

const description =
  'One person, end to end — how I work, what the four steps are, what a website costs, and the questions that come up before booking.';
---

<BaseLayout title="About" description={description}>
  <section class="head">
    <p class="eyebrow m-0">About</p>
    <h1>One person, start to finish.</h1>
    <p class="head-p">
      I'm Yameen. I design it, build it, wire up whatever sits behind it, and
      put it on the internet — so there is no agency layer between you and the
      person doing the work, and one person who knows why every decision was
      made.
    </p>
  </section>

  <section class="sec">
    <h2>What I build</h2>
    <dl class="rows rv">
      {capability.map(([term, detail]) => (
        <div class="row">
          <dt class="eyebrow m-0">{term}</dt>
          <dd>{detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sec">
    <h2>How it works</h2>
    <dl class="rows rv">
      {steps.map(([name, detail], i) => (
        <div class="row">
          <dt class="eyebrow m-0">{String(i + 1).padStart(2, '0')} · {name}</dt>
          <dd>{detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sec">
    <h2>What a website costs</h2>
    <p class="sec-p rv">
      A one-off build to get you online, then a small monthly care plan to keep
      it running. Pick the size that fits — you can move up later.
    </p>

    <div class="plans">
      {plans.map((p) => (
        <div class="plan panel rv">
          <h3>{p.name}</h3>
          <p class="plan-fig">{p.build}</p>
          <p class="eyebrow plan-care">+ {p.care} care plan</p>
          <p class="plan-blurb">{p.blurb}</p>
          <ul>
            {p.includes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="rows rv terms-rows">
      <div class="row">
        <p class="eyebrow m-0">How payment works</p>
        <div>
          <p>
            Builds split 50% deposit to book your slot and 50% on launch. Care
            plans start when the site goes live and are collected by monthly
            Direct Debit — cancel any time with 30 days' notice.
          </p>
          <p>
            Those prices cover websites. Booking systems, apps, backends and
            anything with a database behind it are quoted per project — tell me
            what you need and I'll price it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <h2>Questions I get asked</h2>
    <dl class="faqs">
      {faqs.map(([q, a]) => (
        <div class="faq rv">
          <dt>{q}</dt>
          <dd>{a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="ask">
    <h2 class="rv">Start something</h2>
    <p class="rv ask-p">Tell me what you do and I'll tell you what it takes.</p>
    <div class="rv ask-do">
      <a class="btn" href="https://wa.me/447404901859" target="_blank" rel="noopener">Message me on WhatsApp</a>
      <a class="btn btn-ghost" href="/contact.html">Other ways to reach me</a>
    </div>
  </section>
</BaseLayout>

<style>
  .head { padding-block: clamp(40px, 7vh, 74px) 0; }
  .head h1 { font-size: clamp(2.6rem, 8.4vw, 5.4rem); margin: 14px 0 0; max-width: 15ch; }
  .head-p { margin: 26px 0 0; max-width: 56ch; color: var(--color-ink-2); font-size: 1.05rem; }

  .sec { padding-block: clamp(54px, 9vh, 92px) 0; }
  .sec h2 { font-size: clamp(1.9rem, 5vw, 3rem); margin: 0; }
  .sec-p { margin: 20px 0 0; max-width: 54ch; color: var(--color-ink-2); }

  .rows { margin: 30px 0 0; display: grid; gap: 2px; }
  .row {
    display: grid; grid-template-columns: 1fr; gap: 8px;
    padding: 20px 22px;
    background: var(--color-line-2);
    border-radius: var(--radius-sm);
  }
  @media (min-width: 820px) { .row { grid-template-columns: 210px 1fr; gap: 30px; } }
  .row dd, .row p { margin: 0; color: var(--color-ink-2); }
  .row div p + p { margin-top: 14px; }
  .terms-rows { margin-top: 34px; }

  .plans { margin: 32px 0 0; display: grid; gap: 18px; }
  @media (min-width: 900px) { .plans { grid-template-columns: repeat(3, 1fr); } }
  .plan { padding: 26px; display: flex; flex-direction: column; }
  .plan h3 { margin: 0; font-size: 1.35rem; }
  .plan-fig {
    margin: 14px 0 0; font-family: var(--font-disp); font-weight: 800;
    font-size: 2.3rem; line-height: 1; letter-spacing: -0.04em;
  }
  .plan-care { margin: 8px 0 0; }
  .plan-blurb { margin: 16px 0 0; font-size: 15px; line-height: 1.5; }
  .plan ul { margin: 16px 0 0; padding: 0; list-style: none; display: grid; gap: 7px; }
  .plan li {
    font-size: 14.5px; padding-left: 18px; position: relative;
    color: color-mix(in srgb, var(--color-ink) 74%, transparent);
  }
  .plan li::before {
    content: ''; position: absolute; left: 0; top: 9px;
    width: 7px; height: 7px; background: var(--color-blue); border-radius: 50%;
  }

  .faqs { margin: 30px 0 0; display: grid; gap: 2px; }
  .faq {
    display: grid; grid-template-columns: 1fr; gap: 8px;
    padding: 22px; background: var(--color-line-2); border-radius: var(--radius-sm);
  }
  @media (min-width: 820px) { .faq { grid-template-columns: 1fr 1.25fr; gap: 34px; } }
  .faq dt { font-family: var(--font-disp); font-weight: 700; font-size: 17px; letter-spacing: -0.015em; line-height: 1.3; }
  .faq dd { margin: 0; color: var(--color-ink-2); font-size: 15.5px; line-height: 1.55; }

  .ask { padding-block: clamp(64px, 11vh, 118px); }
  .ask h2 { font-size: clamp(2rem, 5.4vw, 3.4rem); margin: 0; }
  .ask-p { margin: 20px 0 0; color: var(--color-ink-2); }
  .ask-do { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 14px; }
</style>
