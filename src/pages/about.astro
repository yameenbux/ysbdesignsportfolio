---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * About, with the old services.html content folded in (CLAUDE.md,
 * "## Structure").
 *
 * Deliberately carried over: the four-step process and the three price
 * tiers, verbatim on the numbers — those are real business terms and not
 * mine to reword.
 *
 * Deliberately left behind, each for a stated reason:
 *  - the LuxeScent testimonial — the copy rules say no testimonials
 *  - the "Most popular" badge on the Business tier — an unevidenced claim
 *    about volume, which the copy rules also bar
 *  - the YSB Ventures Ltd registration details — removed at the user's
 *    request earlier ("remove my limited business info")
 *  - "websites for trades and takeaways across Greater Manchester" — the
 *    old narrow positioning, superseded
 *
 * No portrait: confirmed we design around its absence rather than ship the
 * PORTRAIT PENDING placeholder.
 */

const steps = [
  ['Chat', "Message me on WhatsApp. We talk through what you need and I give you a fixed quote — no obligation."],
  ['Book', 'A 50% deposit books your slot, and I start gathering your content and photos.'],
  ['Build', "I design and build it, share a live preview, and refine it with you until it's right."],
  ['Launch', 'Final balance, we go live, and the care plan keeps it fast, secure and up to date.'],
];

const plans = [
  {
    name: 'Starter',
    build: '£495',
    care: '£20/mo',
    blurb: 'A sharp one-page presence for a small local business.',
    includes: [
      '1–3 page mobile website',
      'WhatsApp and click-to-call buttons',
      'Google Business Profile set up',
      'Hosting, domain and security included',
      'Up to 30 minutes of edits each month',
    ],
  },
  {
    name: 'Business',
    build: '£895',
    care: '£35/mo',
    blurb: 'For businesses that want enquiries, not just a listing.',
    includes: [
      '4–6 page website',
      'Photo gallery and enquiry form',
      'Customer reviews section',
      'Basic local SEO to rank in your area',
      'Up to 1 hour of edits each month',
    ],
  },
  {
    name: 'Premium',
    build: 'from £1,500',
    care: '£55/mo',
    blurb: 'Bigger sites with menus, ordering or content built in.',
    includes: [
      '6+ pages, or a custom build',
      'Menus or online ordering integration',
      'Blog or news section',
      'Ongoing SEO monitoring',
      'Priority support and content updates',
    ],
  },
];

const description =
  'One person, end to end — how I work, what the four steps are, and what a website costs. Software, backends and hosting are quoted per project.';
---

<BaseLayout title="About" description={description}>
  <section>
    <p class="label">About</p>
    <h1 class="mt-5 text-[clamp(2rem,4vw,3rem)] font-semibold leading-[1.15] tracking-[-0.015em]">
      One person, start to finish.
    </h1>
    <p class="measure mt-6 text-[17px] leading-[1.6] text-muted">
      I'm Yameen. I design it, build it, wire up whatever sits behind it, and
      put it on the internet — so there is no agency layer between you and the
      person doing the work, and one person who knows why every decision was
      made.
    </p>
  </section>

  <section class="mt-20 border-t border-rule pt-3">
    <h2 class="label m-0">How it works</h2>

    <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-12">
      {steps.map(([name, detail], i) => (
        <div class="contents">
          <p class="label m-0 md:col-span-3">
            {String(i + 1).padStart(2, '0')} · {name}
          </p>
          <p class="measure m-0 text-[17px] leading-[1.6] text-muted md:col-span-9">{detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-20 border-t border-rule pt-3">
    <h2 class="label m-0">What a website costs</h2>

    <div class="mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-12">
      <p class="measure m-0 text-[17px] leading-[1.6] md:col-span-9 md:col-start-4">
        A one-off build to get you online, then a small monthly care plan to
        keep it running. Pick the size that fits — you can move up later.
      </p>
    </div>

    {/* Rows separated by rules, not cards. */}
    <div class="mt-12 space-y-10">
      {plans.map((p) => (
        <div class="grid grid-cols-1 gap-x-8 gap-y-4 border-t border-rule pt-6 md:grid-cols-12">
          <div class="md:col-span-3">
            <h3 class="m-0 text-[21px] font-semibold tracking-[-0.01em]">{p.name}</h3>
            <p class="label m-0 mt-3">{p.build} build</p>
            <p class="label m-0 mt-1">+ {p.care} care plan</p>
          </div>

          <div class="md:col-span-9">
            <p class="measure m-0 text-[17px] leading-[1.6]">{p.blurb}</p>
            <ul class="mt-4 list-none space-y-2 p-0">
              {p.includes.map((item) => (
                <li class="text-[17px] leading-[1.6] text-muted">{item}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 grid grid-cols-1 gap-x-8 md:grid-cols-12">
      <div class="md:col-span-9 md:col-start-4">
        <p class="label m-0">How payment works</p>
        <p class="measure mt-3 text-[17px] leading-[1.6] text-muted">
          Builds split 50% deposit to book your slot and 50% on launch. Care
          plans start when the site goes live and are collected by monthly
          Direct Debit — cancel any time with 30 days' notice.
        </p>
        <p class="measure mt-4 text-[17px] leading-[1.6] text-muted">
          Those prices cover websites. Booking systems, apps, backends and
          anything with a database behind it are quoted per project — tell me
          what you need and I'll price it.
        </p>
      </div>
    </div>
  </section>

  <section class="mt-20 border-t border-rule pt-3">
    <h2 class="label m-0">Start something</h2>

    <div class="mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-12">
      <div class="md:col-span-9 md:col-start-4">
        <p class="measure m-0 text-[17px] leading-[1.6]">
          Tell me what you do and I'll tell you what it takes.
        </p>
        <p class="mt-8">
          <a
            href="/contact.html"
            class="border border-accent px-5 py-3 text-[15px] font-medium text-accent no-underline transition-colors duration-150 ease-out hover:bg-accent hover:text-bg"
            style="border-radius: var(--radius-sm)"
          >
            Get in touch
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
