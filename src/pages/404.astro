---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Custom 404. GitHub Pages serves /404.html for any unmatched path on a
 * custom domain with no extra configuration, so this needs no routing work.
 *
 * noindex, because a soft 404 in the index is worse than none: static hosting
 * returns this page with a real 404 status, but the meta tag makes the
 * intent explicit for anything that follows a stale link.
 *
 * The three unlisted case studies are deliberately linked from here. They are
 * live and indexed but not in the work index, so a visitor who lands on a
 * mistyped URL from an old link has somewhere to go.
 */

const routes = [
  ['/work.html', 'Work', 'The three projects, written up.'],
  ['/about.html', 'About', 'How I work, the four steps, and what it costs.'],
  ['/contact.html', 'Contact', 'WhatsApp, phone, LinkedIn.'],
];
---

<BaseLayout title="Page not found" description="That page isn't here. The work, the process and the ways to get in touch are." noindex={true}>
  <section class="pt-16">
    <p class="label label-blue m-0">Error 404</p>
    <h1 class="mt-5 text-[clamp(2.4rem,5.6vw,4rem)] font-extrabold leading-[1] tracking-[-0.03em] [font-variation-settings:'wdth'_112]">
      That page isn't here.
    </h1>
    <p class="measure mt-6 text-ink-2">
      Either the link is wrong or I moved something and didn't tell you. Here
      is everything the site has.
    </p>
  </section>

  <section class="border-t border-line py-16 md:py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Where to go</h2>

    <dl class="rv mt-10 grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-12">
      {routes.map(([href, name, detail]) => (
        <div class="contents">
          <dt class="label m-0 md:col-span-3">
            <a href={href} class="label-ink no-underline transition-colors duration-150 hover:text-blue">{name} →</a>
          </dt>
          <dd class="measure m-0 text-ink-2 md:col-span-9">{detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="border-t border-line py-16 md:py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Looking for a case study?</h2>
    <p class="rv measure mt-6 text-ink-2">
      Six are written up. Three are in the work index; the other three are
      here.
    </p>
    <ul class="rv mt-6 flex list-none flex-wrap gap-x-7 gap-y-3 p-0">
      {[
        ['/taiyabah.html', 'Taiyabah Masjid'],
        ['/venetian.html', 'The Venetian Company'],
        ['/hairbychrissy.html', 'Hair by Chrissy'],
        ['/ellash.html', 'Ellash'],
        ['/buxtravel.html', 'Bux Travel'],
        ['/luxescent.html', 'LuxeScent'],
      ].map(([href, name]) => (
        <li>
          <a href={href} class="label label-ink underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-blue hover:decoration-blue">{name}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-line py-16 md:py-24">
    <h2 class="text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">Or just ask me</h2>
    <p class="rv measure mt-6 text-ink-2">Tell me what you were looking for and I'll point you at it.</p>
    <div class="rv mt-8 flex flex-wrap items-center gap-3.5">
      <a class="btn" href="https://wa.me/447404901859" target="_blank" rel="noopener">Message me on WhatsApp</a>
      <a class="btn btn-ghost" href="/">Back to the homepage</a>
    </div>
  </section>
</BaseLayout>
