---
/**
 * "Build your stack" — a rough figure without a form, an email or a lead
 * capture. Nothing is sent anywhere; it exists so a visitor can find out
 * roughly what they are in for before they message.
 *
 * Prices are the real tiers from CLAUDE.md, decomposed into the pieces a
 * person actually recognises. The "layers" read-out ties the total back to
 * the positioning line — the site, the software, the hosting.
 *
 * Every option is a real <button> with aria-pressed, so the whole thing works
 * from the keyboard with no extra handling.
 */
const options = [
  { id: 'site',    price: 495, care: 20, layer: 1, name: 'A site people can find',           note: 'A few pages, fast, turns a search into a phone call.' },
  { id: 'pages',   price: 400, care: 15, layer: 1, name: 'More pages, photos, enquiry form', note: 'For a business that wants enquiries, not just a listing.' },
  { id: 'booking', price: 900, care: 20, layer: 2, name: 'Bookings or ordering',             note: 'Live availability, deposits, a real calendar behind it.' },
  { id: 'admin',   price: 750, care: 15, layer: 2, name: 'An account area or admin',         note: 'Somewhere you or your customers log in and manage things.' },
  { id: 'app',     price: 600, care: 20, layer: 3, name: 'An installable app',               note: 'Adds to a phone home screen, works offline, sends alerts.' },
];
---

<div class="est">
  <div class="est-list" id="estOpts">
    {options.map((o, i) => (
      <button type="button" class="est-opt" aria-pressed={i === 0 ? 'true' : 'false'}
              data-price={o.price} data-care={o.care} data-layer={o.layer}>
        <span class="est-box" aria-hidden="true"></span>
        <span class="est-txt">
          <b>{o.name}</b>
          <small>{o.note}</small>
        </span>
      </button>
    ))}
  </div>

  <aside class="est-out panel" aria-live="polite">
    <p class="eyebrow m-0">From, one-off build</p>
    <p id="estFig" class="est-fig">£495</p>
    <ul class="est-facts">
      <li><b id="estCare">£20</b> a month to keep it running</li>
      <li>Layers touched <b id="estLayers">1 of 3</b></li>
      <li>50% to book, 50% on launch</li>
    </ul>
    <p class="est-note">
      A real number needs a real conversation — this is the shape of it, not a
      quote. Nothing here is sent anywhere.
    </p>
    <a class="btn est-cta" href="/contact.html">Talk it through</a>
  </aside>
</div>

<style>
  .est { display: grid; grid-template-columns: 1fr; gap: 30px; }
  @media (min-width: 940px) { .est { grid-template-columns: 1fr 372px; gap: 52px; } }

  .est-list { display: flex; flex-direction: column; gap: 10px; }

  .est-opt {
    display: flex; align-items: flex-start; gap: 15px;
    padding: 17px 19px; text-align: left; cursor: pointer;
    font: inherit; color: var(--color-ink);
    background: var(--color-line-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    transition: transform 0.2s var(--ease-turn), background 0.2s, border-color 0.2s;
  }
  .est-opt:hover { transform: translateX(4px); background: var(--color-plane); border-color: var(--color-line); }
  .est-opt[aria-pressed="true"] { border-color: var(--color-blue); background: color-mix(in srgb, var(--color-blue) 7%, var(--color-plane)); }

  .est-box {
    position: relative; flex: none;
    width: 17px; height: 17px; margin-top: 3px;
    border: 1.5px solid var(--color-ink-2);
    border-radius: 2px;
  }
  .est-opt[aria-pressed="true"] .est-box { background: var(--color-blue); border-color: var(--color-blue); }
  .est-opt[aria-pressed="true"] .est-box::after {
    content: ''; position: absolute; left: 5px; top: 1px;
    width: 4px; height: 9px;
    border: solid var(--color-ink); border-width: 0 2px 2px 0;
    transform: rotate(42deg);
  }

  .est-txt b { display: block; font-family: var(--font-disp); font-weight: 700; font-size: 16px; letter-spacing: -0.01em; }
  .est-txt small { display: block; margin-top: 3px; font-size: 14px; color: var(--color-ink-2); }

  .est-out { align-self: start; padding: 28px; }
  .est-out .eyebrow { color: var(--color-ink-2); }
  @media (min-width: 940px) { .est-out { position: sticky; top: 24px; } }

  .est-fig {
    margin: 10px 0 0;
    font-family: var(--font-disp); font-weight: 800;
    font-size: 3.1rem; line-height: 1; letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .est-facts {
    margin: 20px 0 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 7px;
    font-size: 14px;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
  }
  .est-facts b { color: var(--color-ink); font-weight: 700; }
  .est-note {
    margin: 20px 0 0; font-size: 13.5px; line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
  }
  .est-cta { margin-top: 22px; }
</style>

<script>
  const opts = [...document.querySelectorAll('.est-opt')];
  const fig = document.getElementById('estFig');
  const care = document.getElementById('estCare');
  const lay = document.getElementById('estLayers');

  if (opts.length && fig && care && lay) {
    const money = (n) => '£' + n.toLocaleString('en-GB');
    const recalc = () => {
      let total = 0, careTotal = 0;
      const layers = new Set();
      for (const o of opts) {
        if (o.getAttribute('aria-pressed') === 'true') {
          total += +o.dataset.price;
          careTotal += +o.dataset.care;
          layers.add(o.dataset.layer);
        }
      }
      fig.textContent = total ? money(total) : '—';
      care.textContent = money(careTotal);
      lay.textContent = `${layers.size} of 3`;
    };
    for (const o of opts) {
      o.addEventListener('click', () => {
        o.setAttribute('aria-pressed', o.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        recalc();
      });
    }
    recalc();
  }
</script>
