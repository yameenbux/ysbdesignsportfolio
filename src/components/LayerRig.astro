---
/**
 * The hero diagram: three sheets — what people see, the software behind it,
 * where it runs — that separate under the cursor and can be pulled apart.
 *
 * Accessibility notes, since this is the one genuinely interactive thing on
 * the site:
 *  - the whole rig is a slider (role/aria), driven by arrow keys and Home/End
 *  - each sheet is labelled, so the diagram reads as three named layers
 *    rather than three anonymous boxes
 *  - with prefers-reduced-motion the sheets are laid out statically, already
 *    separated, and the pointer/drag behaviour never binds
 */
const { shot, shotAlt } = Astro.props;
---

<div class="relative">
  <div
    id="rig"
    class="relative h-[430px] cursor-grab touch-none [perspective:1400px] max-md:h-[380px]"
    role="slider"
    tabindex="0"
    aria-label="Diagram: the three layers of a build. Use arrow keys to pull them apart."
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-valuetext="Layers stacked"
  >
    <!-- 01 — what people see -->
    <div class="rig-layer" data-depth="3">
      <div class="sheet sheet-lift overflow-hidden">
        <img src={shot} alt={shotAlt} width="760" height="475" class="block h-auto w-full" fetchpriority="high" decoding="async" />
      </div>
      <p class="anno label"><span class="dash"></span><span class="label-ink">01 · What people see</span></p>
    </div>

    <!-- 02 — the software behind it -->
    <div class="rig-layer" data-depth="2">
      <div class="sheet min-h-[118px] px-6 py-5">
        <div class="my-[9px] flex items-center gap-2.5"><span class="chip">Booking</span><span class="wire"></span><span class="chip">Calendar</span></div>
        <div class="my-[9px] flex items-center gap-2.5"><span class="chip">Payments</span><span class="wire"></span><span class="chip">Email</span></div>
        <div class="my-[9px] flex items-center gap-2.5"><span class="chip">Database</span><span class="wire"></span><span class="chip">Admin</span></div>
      </div>
      <p class="anno label"><span class="dash"></span><span class="label-ink">02 · The software behind it</span></p>
    </div>

    <!-- 03 — where it runs -->
    <div class="rig-layer" data-depth="1">
      <div class="sheet min-h-[96px] px-6 py-5">
        <div class="my-[9px] flex items-center gap-2.5"><span class="pulse"></span><span class="chip">Edge / CDN</span><span class="wire"></span><span class="chip">SSL</span></div>
        <div class="my-[9px] flex items-center gap-2.5"><span class="chip">CI/CD</span><span class="wire"></span><span class="chip">Backups</span><span class="chip">Domain</span></div>
      </div>
      <p class="anno label"><span class="dash"></span><span class="label-ink">03 · Where it runs</span></p>
    </div>
  </div>

  <p class="rig-hint label mt-3 flex flex-wrap items-center gap-2">
    <span class="sheet px-[7px] py-[2px] font-mono text-[10.5px]">drag</span>
    <span>or</span>
    <span class="sheet px-[7px] py-[2px] font-mono text-[10.5px]">↑ ↓</span>
    <span class="max-[700px]:hidden">to pull the stack apart</span><span class="hidden max-[700px]:inline">scroll to pull the stack apart</span>
    <button id="rigReset" type="button" class="ml-1 cursor-pointer underline underline-offset-2 hover:text-blue">reset</button>
  </p>
</div>

<style>
  .rig-layer {
    position: absolute; left: 50%; top: 50%;
    width: min(420px, 86%);
    transform-style: preserve-3d; will-change: transform;
    transition: transform 0.5s var(--ease-draft);
  }
  /* On wide screens the sheets sit left of centre so the leader-line labels
     have somewhere to go without pushing the page sideways. */
  @media (min-width: 960px) { .rig-layer { left: 40%; width: min(360px, 78%); } }

  .rig-layer .anno { position: absolute; left: calc(100% + 14px); top: 14px; margin: 0; }

  /* Below 700px the sheets become a deck rather than a 3D fan: stacked with
     each lower card peeking out below, draggable to spread. Leader lines
     have nowhere to go at this width, so each label moves inside its own
     card's visible strip — which is what collided when they floated outside. */
  @media (max-width: 700px) {
    /* touch-action must not be none here: the rig is 470px tall and blocking
       it means a swipe over the hero does not scroll the page at all. */
    #rig { height: 470px; perspective: 900px; touch-action: auto; }
    /* The screenshot is cropped short on a phone so all three sheets fit the
       deck in reading order with each label clear of the sheet above it. */
    .rig-layer[data-depth="3"] .sheet { height: 132px; }
    .rig-layer[data-depth="3"] img { height: 100%; object-fit: cover; object-position: top center; }
    /* Anchored left/right rather than left:50% + translateX(-50%): the
       untransformed box of a 50%-offset absolute element overhangs the
       viewport and lands in scrollWidth even though the transform pulls it
       back visually. That was ~99px of phantom horizontal scroll. */
    .rig-layer { left: 6%; right: 6%; top: 0; width: auto; }
    .rig-layer .anno {
      left: 12px; top: 10px; right: auto;
      background: var(--color-paper); border: 1px solid var(--color-line);
      border-radius: var(--radius-sm); padding: 4px 9px;
    }
    .rig-layer .anno .dash { display: none; }
  }

  /* Reduced motion, at any width: a plain labelled stack, nothing moving. */
  @media (prefers-reduced-motion: reduce) {
    #rig {
      height: auto !important; display: flex; flex-direction: column; gap: 26px;
      cursor: default; perspective: none;
    }
    .rig-layer { position: static; width: 100%; transform: none !important; transition: none; }
    .rig-layer .anno {
      position: static; margin-top: 10px;
      background: none; border: 0; padding: 0;
    }
    .rig-hint { display: none; }
  }
</style>

<script>
  const rig = document.getElementById('rig');
  if (rig) {
    // Only reduced motion is static now. Narrow screens get the deck.
    const staticMode = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const deck = () => matchMedia('(max-width: 700px)').matches;
    const layers = [...rig.querySelectorAll('.rig-layer')];

    if (staticMode) {
      // Static layout handles it; bind nothing, animate nothing.
      rig.removeAttribute('role');
      rig.removeAttribute('tabindex');
    } else {
      let spread = 0, target = 0, px = 0, py = 0, tx = 0, ty = 0;
      let raf = null, visible = true;

      const announce = () => {
        const pct = Math.round(target * 100);
        rig.setAttribute('aria-valuenow', String(pct));
        rig.setAttribute('aria-valuetext', pct === 0 ? 'Layers stacked' : `Layers ${pct}% apart`);
      };

      function tick() {
        // Entrance: each sheet slides up into the stack, lowest first.
        const intro = Math.min(1, (performance.now() - introFrom) / 1100);
        px += (tx - px) * 0.09;
        py += (ty - py) * 0.09;
        spread += (target - spread) * 0.1;
        const isDeck = deck();
        for (const l of layers) {
          const d = +l.dataset.depth;
          if (isDeck) {
            // A deck in reading order — 01 at the top, 03 at the bottom,
            // matching the fan on wider screens. The step clears the sheet
            // above, so every label stays uncovered.
            const step = 150 + spread * 58;
            l.style.zIndex = String(d);
            const e = Math.max(0, Math.min(1, (intro - (3 - d) * 0.13) / 0.62));
            const ease = 1 - Math.pow(1 - e, 3);
            l.style.opacity = String(ease);
            // No percentage translate here — the layer is anchored by
            // left/right, so any -50% would reintroduce the overhang.
            l.style.transform =
              `rotateX(${4 + py * 3}deg)` +
              ` translate3d(${px * 4}px, ${(3 - d) * step + (1 - ease) * 54}px, 0)`;
          } else {
            const z = (d - 2) * (60 + spread * 150);
            const lift = (d - 2) * (spread * 46);
            const e = Math.max(0, Math.min(1, (intro - (3 - d) * 0.13) / 0.62));
            const ease = 1 - Math.pow(1 - e, 3);
            l.style.opacity = String(ease);
            l.style.zIndex = '';
            l.style.transform =
              `translate(-50%,-50%) rotateX(${10 + py * 7}deg) rotateY(${px * 12}deg)` +
              ` translate3d(${px * d * 7}px, ${-lift + py * d * 5 + (1 - ease) * 42}px, ${z}px)`;
          }
        }
        // Settle: once the rig has stopped moving and nothing is driving it,
        // stop burning frames until something changes.
        const still = intro >= 1
          && Math.abs(target - spread) < 0.0005
          && Math.abs(tx - px) < 0.002 && Math.abs(ty - py) < 0.002;
        raf = (still || !visible) ? null : requestAnimationFrame(tick);
      }
      // Deliberately not gated on `visible`: that flag is only correct once
      // the observer has fired, and a kick arriving before then was dropped,
      // which left the deck frozen while scroll was updating its target.
      // tick() stops itself on the next frame if the rig really is off screen.
      const kick = () => { if (raf === null) raf = requestAnimationFrame(tick); };

      // On a phone there is no cursor and dragging would fight the page
      // scroll, so the scroll itself opens the stack: the sheets fan apart
      // over the first stretch of the page. This is the motion that a touch
      // visitor actually gets, so it has to carry the idea on its own.
      let introFrom = 0;
      const fromScroll = () => {
        if (!deck()) return;
        target = Math.max(0, Math.min(1, scrollY / 420));
        announce();
        kick();
      };
      addEventListener('scroll', fromScroll, { passive: true });

      // Pause entirely when the hero is scrolled away.
      new IntersectionObserver((es) => {
        for (const e of es) {
          visible = e.isIntersecting;
          if (visible) kick();
          else if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
        }
      }).observe(rig);

      const readPointer = (e) => {
        const r = rig.getBoundingClientRect();
        const p = e.touches ? e.touches[0] : e;
        tx = ((p.clientX - r.left) / r.width - 0.5) * 2;
        ty = ((p.clientY - r.top) / r.height - 0.5) * 2;
        kick();
      };
      rig.addEventListener('mousemove', readPointer);
      rig.addEventListener('mouseleave', () => { tx = 0; ty = 0; kick(); });

      let dragging = false, startY = 0, startSpread = 0;
      const down = (e) => {
        if (e.touches && deck()) return;   // scroll owns vertical gestures here
        dragging = true; rig.classList.add('cursor-grabbing');
        startY = (e.touches ? e.touches[0] : e).clientY; startSpread = target;
      };
      const move = (e) => {
        if (e.touches && deck()) return;
        readPointer(e);
        if (!dragging) return;
        const y = (e.touches ? e.touches[0] : e).clientY;
        target = Math.max(0, Math.min(1, startSpread + (startY - y) / 260));
        announce();
        if (e.cancelable) e.preventDefault();
      };
      const up = () => { dragging = false; rig.classList.remove('cursor-grabbing'); };
      rig.addEventListener('mousedown', down);
      rig.addEventListener('touchstart', down, { passive: true });
      addEventListener('mousemove', move);
      addEventListener('touchmove', move, { passive: false });
      addEventListener('mouseup', up);
      addEventListener('touchend', up);

      rig.addEventListener('keydown', (e) => {
        const step = e.shiftKey ? 0.25 : 0.1;
        let handled = true;
        if (e.key === 'ArrowUp' || e.key === 'ArrowRight') target = Math.min(1, target + step);
        else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') target = Math.max(0, target - step);
        else if (e.key === 'Home') target = 0;
        else if (e.key === 'End') target = 1;
        else handled = false;
        if (handled) { e.preventDefault(); announce(); kick(); }
      });

      document.getElementById('rigReset')?.addEventListener('click', () => { target = 0; announce(); kick(); });

      matchMedia('(max-width: 700px)').addEventListener('change', kick);

      introFrom = performance.now();
      kick();
      if (deck()) {
        fromScroll();
      } else {
        // Open once on load so the affordance is obvious, then settle apart
        // enough that it reads as three sheets rather than one.
        setTimeout(() => { target = 0.55; announce(); kick();
          setTimeout(() => { target = 0.34; announce(); kick(); }, 1100);
        }, 700);
      }
    }
  }
</script>
