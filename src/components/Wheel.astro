---
/**
 * The wheel — v3's signature.
 *
 * Six projects on a large circle whose centre sits below the viewport, so
 * only the top arc is visible. Scrolling turns the wheel; whichever card
 * reaches top dead centre is upright, in full colour, and named in the
 * read-out beneath it.
 *
 * That last part is the point. A wheel that only spins is decoration; this
 * one is a control — the rotation says which project you are looking at, and
 * the read-out is its display. Cards are tangential to the circle, so the
 * active one is the only upright one and you can find it without being told.
 *
 * Ported from a React + GSAP ScrollTrigger component, deliberately not by
 * installing React and GSAP:
 *
 *  - The pin is `position: sticky`, not ScrollTrigger's `pin: true`. Sticky
 *    is the browser's own mechanism, so the scrollbar keeps its real length,
 *    the page never jumps on refresh, and a swipe over the wheel scrolls the
 *    page like a swipe anywhere else. No touch-action to get wrong.
 *  - Rotation is read off scroll position in a rAF loop that stops when the
 *    wheel leaves the viewport, so an idle page requests no frames.
 *  - The cards are real links. The original used role="button" divs, which
 *    cost the browser's own focus, middle-click and open-in-new-tab.
 *
 * Keyboard: tab through the cards and the wheel turns to bring each to top.
 * Reduced motion: no sticky, no rotation, no fade — a plain grid of the same
 * six links, with every card readable at once.
 */

const { items = [] } = Astro.props;

const n = items.length;
const step = 360 / n;
---

<section class="track" id="wheelTrack" aria-labelledby="wheelHeading">
  <div class="stage">
    <div class="stage-head">
      <p class="eyebrow m-0" id="wheelHeading">Selected work</p>
      <span class="head-sep" aria-hidden="true"></span>
      <a class="eyebrow ul-draw head-all" href="/work.html">All {n}, written up →</a>
    </div>

    <div class="ring-box">
      <ul class="ring" id="ring" style={`--n:${n}`}>
        {items.map((p, i) => (
          <li class="spoke" style={`--a:${i * step}deg`} data-i={i}>
            <a href={p.href} class="card" data-card={i}>
              <span class="card-shot">
                <img src={p.img} alt={p.alt} width="760" height="475" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
              </span>
              <span class="card-foot">
                <span class="card-name">{p.name}</span>
                <span class="eyebrow card-kind">{p.kind}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {/* The wheel's display. One block, swapped rather than re-rendered, so
        the browser never reflows the sticky stage mid-scroll. */}
    <div class="readout" id="readout" aria-live="polite">
      {items.map((p, i) => (
        <div class="read" data-read={i} hidden={i !== 0}>
          <p class="eyebrow eyebrow-accent m-0">
            <span class="live" aria-hidden="true"></span> {p.kind} · {p.where}
          </p>
          <h2 class="read-name">{p.name}</h2>
          <p class="read-line">{p.line}</p>

          {/* Which of the three layers this project actually needed. The
              positioning line claims three; this is where the claim gets
              evidence, project by project. */}
          <ul class="layers" aria-label={`What ${p.name} needed`}>
            {[['Interface', p.layers.interface], ['Software', p.layers.software], ['Infrastructure', p.layers.infra]].map(([name, w]) => (
              <li>
                <span class="eyebrow layer-name">{name}</span>
                <span class="layer-bar"><i style={`width:${w}%`}></i></span>
              </li>
            ))}
          </ul>

          <p class="read-go"><a href={p.href} class="ul-draw ul-draw-on">Read the {p.name} case study →</a></p>
        </div>
      ))}
    </div>
    {/* The wheel turns with the scroll, which means a visitor scanning the
        page sees one project unless they commit to the whole run. This rail
        is the way out of that: it says how many there are, which one you are
        on, and jumps straight to any of them. Real buttons, so it works from
        the keyboard without extra handling. */}
    <div class="rail">
      <span class="eyebrow rail-count"><b id="railNow">1</b> / {n}</span>
      <ol class="rail-ticks" id="rail">
        {items.map((p, i) => (
          <li>
            <button type="button" data-go={i} aria-label={`Show ${p.name}`}
                    aria-current={i === 0 ? 'true' : 'false'}><span></span></button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* The scroll budget. 100vh of stage plus this much travel, which is what
     the sticky element sticks through. One full turn over the whole run. */
  /* One full turn over this much travel. It was 2600; six projects at that
     rate is a long commitment for a visitor who is scanning, and the rail
     below the read-out is the shortcut for anyone who does not want to. */
  .track { height: calc(100vh + 2200px); position: relative; }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 620px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .stage-head {
    padding: 26px 24px 0; flex: none;
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: center; gap: 6px 18px;
  }
  .head-all { text-decoration: none; }
  .head-sep { width: 26px; height: 1px; background: var(--color-line); }

  /* No clip here on purpose. Clipping a box that is exactly the circle's
     bounding square makes Chromium paint the clip edge as a 1px seam — two
     vertical lines at the circle's extremes, with no element that has a
     border to blame. Nothing needs clipping at this level anyway: cards more
     than 62deg from the top are at opacity 0, and .stage clips the rest. */
  .ring-box {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* --r radius, --arc how much of the circle shows above the box's bottom
     edge. Both are set per breakpoint and then corrected once by script from
     the measured card height, so the top card is never clipped. */
  /* The ring is a point, not a box: the circle's centre, sitting below the
     visible area with the spokes hung off it. It was a 2r square, which is
     the shape Chromium painted a 1px seam around at the circle's left and
     right extremes — two vertical lines that no border, background or
     outline in the page could account for. A zero-size element has no edge
     to seam, and no width to reach into scrollWidth from left:50%. */
  .ring {
    --r: 560px;
    --arc: 300px;
    position: absolute;
    left: 50%;
    bottom: calc(var(--arc) - var(--r));
    width: 0; height: 0;
    margin: 0; padding: 0;
    list-style: none;
  }

  /* Each spoke carries its own angle and the script advances all six, rather
     than the ring being rotated as one. Rotating the ring meant compositing a
     1120px mostly-empty layer, whose antialiased edges painted as hairline
     diagonals across the stage — visible as two crossing lines with no
     element to blame, since nothing on the page has a border. */
  .spoke {
    position: absolute;
    left: 0; top: 0;
    /* rotate, then step out along the new up-axis: the card lands at --a from
       top dead centre and leans by exactly that much, so the card at the top
       is the only upright one. */
    transform: translate(-50%, -50%) rotate(var(--a)) translateY(calc(-1 * var(--r)));
  }

  .card {
    display: block;
    width: 300px;
    text-decoration: none;
    color: var(--color-ink);
    transform-origin: 50% 50%;
  }

  /* Screenshots are light-UI captures; dropped straight onto paper they sit
     flush and disappear. Every card is a sheet with a hairline border, and
     the active one takes the accent and a lift. */
  .card-shot {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 6px;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-plane);
    transition: border-color 0.4s var(--ease-turn), box-shadow 0.4s var(--ease-turn);
  }
  .card-shot img {
    display: block;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Only the card at top dead centre is named. On a faded card the label
     composited to 2:1 against the ground — a real contrast failure, not a
     rounding one — and the read-out underneath already names the active
     project, so a label on a card nobody is looking at was duplicating it. */
  .card-foot {
    display: block; padding-top: 12px;
    opacity: 0;
    transition: opacity 0.3s var(--ease-turn);
  }
  .spoke.is-active .card-foot { opacity: 1; }
  .card-name {
    display: block;
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .card-kind { display: block; margin-top: 3px; font-size: 11px; }

  /* The one at top dead centre. */
  .spoke.is-active .card-shot {
    border-color: var(--color-blue);
    box-shadow: 0 10px 30px rgba(22, 25, 28, 0.13);
  }

  .layers {
    margin: 18px auto 0; padding: 0; list-style: none;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px;
  }
  .layers li { display: flex; align-items: center; gap: 9px; }
  .layer-name { font-size: 10.5px; }
  .layer-bar {
    display: block; width: 62px; height: 4px;
    background: var(--color-line-2); border-radius: 2px; overflow: hidden;
  }
  .layer-bar i {
    display: block; height: 100%;
    background: color-mix(in srgb, var(--color-blue) 55%, transparent);
  }

  /* The spokes are absolutely positioned, so they paint above a static
     sibling however late it comes in the DOM — the cards were lying over the
     rail and swallowing its clicks. Positioned and lifted above them. */
  .rail {
    position: relative; z-index: 3;
    flex: none;
    display: flex; align-items: center; justify-content: center; gap: 16px;
    padding: 0 24px 30px;
  }
  .rail-count b { color: var(--color-ink); font-weight: 700; font-variant-numeric: tabular-nums; }
  .rail-ticks { display: flex; gap: 10px; margin: 0; padding: 0; list-style: none; }
  /* display:list-item still generates a ::marker box even at list-style:none,
     and one of them was painting a stray dot above the third tick. */
  .rail-ticks li { display: block; }
  /* Padding, not the tick itself, carries the target: the visible mark stays
     a 3px rule while the button clears the 24px minimum in both directions. */
  .rail-ticks button {
    display: flex; align-items: center;
    min-width: 26px; min-height: 28px;
    padding: 12px 6px; border: 0; background: none; cursor: pointer;
  }
  .rail-ticks span {
    display: block; width: 26px; height: 3px; border-radius: 2px;
    background: var(--color-line);
    transition: background 0.3s var(--ease-turn), transform 0.3s var(--ease-turn);
  }
  .rail-ticks button:hover span { background: var(--color-ink-2); }
  .rail-ticks button[aria-current="true"] span {
    background: var(--color-blue); transform: scaleY(2);
  }

  .readout {
    flex: none;
    padding: 0 24px 18px;
    text-align: center;
    min-height: 210px;
    position: relative;
    z-index: 2;
  }
  .read-name {
    font-size: clamp(2rem, 5.4vw, 3.4rem);
    margin: 12px 0 0;
  }
  .read-line {
    margin: 12px auto 0;
    max-width: 54ch;
    color: var(--color-ink-2);
    font-size: 16px;
    line-height: 1.55;
  }
  .read-go { margin: 18px 0 0; }
  .read-go a { font-family: var(--font-disp); font-weight: 700; font-size: 14px; }

  /* The read block fades in rather than snapping, but only ever one is in
     the flow — the others are [hidden], so nothing stacks. */
  .read { animation: read-in 0.45s var(--ease-turn) both; }
  @keyframes read-in { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1100px) {
    .ring { --r: 440px; }
    .card { width: 244px; }
  }

  @media (max-width: 760px) {
    .ring { --r: 296px; }
    .card { width: 186px; }
    .card-name { font-size: 15px; }
    /* Two eyebrows and a rule will not sit on one line at this width, and
       wrapping them mid-phrase reads as a mistake. Stack them instead. */
    .stage-head { padding-top: 18px; gap: 4px; }
    .head-sep { display: none; }
    .readout { min-height: 244px; padding-bottom: 14px; }
    .layers { gap: 6px 16px; }
    .layer-bar { width: 48px; }
    .rail { gap: 12px; padding-bottom: 22px; }
    .rail-ticks span { width: 20px; }
    .track { height: calc(100vh + 1800px); }
  }

  /* No wheel at all. Six cards, all readable, no pin and nothing moving —
     the same six links reached the same way. */
  @media (prefers-reduced-motion: reduce) {
    .track { height: auto; }
    .stage { position: static; height: auto; min-height: 0; overflow: visible; display: block; }
    .stage-head { padding: 0 0 28px; text-align: left; }
    .ring {
      position: static; left: auto; width: auto; height: auto; bottom: auto;
      display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 30px;
    }
    .spoke { position: static; transform: none; }
    .card { width: auto; opacity: 1 !important; filter: none !important; transform: none !important; }
    .card-foot { opacity: 1; }
    .card-shot { aspect-ratio: 16 / 10; }
    .readout { display: none; }
    .rail { display: none; }
    .stage-head { justify-content: flex-start; }
    .head-sep { display: none; }
  }
</style>

<script>
  const track = document.getElementById('wheelTrack');
  const ring  = document.getElementById('ring');
  const reads = document.querySelectorAll('[data-read]');

  if (track && ring) {
    const spokes = Array.from(ring.children);
    const cards = spokes.map((s) => s.querySelector('.card'));
    const n = spokes.length;
    const step = 360 / n;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let active = -1;
    let raf = 0;
    let visible = false;

    // The card at top dead centre would be cut in half by the box's top edge
    // if the visible arc were the full box height. Measure one card and pull
    // the arc down by half its height plus a margin.
    // How much of the circle shows above the box's bottom edge — which is
    // what decides how high up the box the top card sits. Aim for a little
    // above centre, then clamp so the card is neither clipped by the box top
    // nor pushed down into the read-out.
    const fitArc = () => {
      const card = cards[0];
      const box = ring.parentElement;
      if (!card || !box) return;
      const h = card.getBoundingClientRect().height;
      const boxH = box.getBoundingClientRect().height;
      // Lower on a phone: the box is proportionally taller there, and a
      // 0.58 arc left a screen's worth of empty blue between the card and
      // the read-out naming it.
      const frac = window.innerWidth < 760 ? 0.46 : 0.58;
      const arc = Math.min(Math.max(h / 2, boxH * frac), Math.max(h / 2, boxH - h / 2 - 8));
      ring.style.setProperty('--arc', arc + 'px');
    };

    const ticks = [...document.querySelectorAll('[data-go]')];
    const railNow = document.getElementById('railNow');

    const show = (i) => {
      if (i === active) return;
      if (active >= 0) {
        spokes[active]?.classList.remove('is-active');
        reads[active]?.setAttribute('hidden', '');
        ticks[active]?.setAttribute('aria-current', 'false');
      }
      spokes[i]?.classList.add('is-active');
      // Re-adding the node restarts the fade without a class-toggle reflow.
      reads[i]?.removeAttribute('hidden');
      ticks[i]?.setAttribute('aria-current', 'true');
      if (railNow) railNow.textContent = String(i + 1);
      active = i;
    };

    // Scroll position that brings project i to top dead centre.
    const scrollFor = (i) => {
      const r = track.getBoundingClientRect();
      return window.scrollY + r.top + (i / n) * (r.height - window.innerHeight);
    };

    ticks.forEach((t, i) => t.addEventListener('click', () => {
      if (reduced.matches) { spokes[i].querySelector('.card')?.scrollIntoView({ block: 'center' }); return; }
      window.scrollTo({ top: scrollFor(i), behavior: 'smooth' });
    }));

    const draw = () => {
      const r = track.getBoundingClientRect();
      // Travel available to the sticky stage: the track's height minus the
      // one viewport it sticks for.
      const run = Math.max(1, r.height - window.innerHeight);
      const p = Math.min(1, Math.max(0, -r.top / run));

      const rot = -p * 360;

      // Fade, shrink and desaturate each card by how far it is from top dead
      // centre, so the wheel reads as one project in focus rather than six
      // competing. 62deg out it is nearly gone; the neighbours sit at 60.
      for (let k = 0; k < n; k++) {
        // 0 at top dead centre, 180 diametrically opposite.
        const a = k * step + rot;
        spokes[k].style.setProperty('--a', a.toFixed(2) + 'deg');

        const d = Math.abs(((a % 360) + 540) % 360 - 180);
        const t = Math.min(1, d / 78);
        const o = Math.max(0, 1 - t * t);
        const card = cards[k];
        card.style.opacity = o.toFixed(3);
        card.style.transform = `scale(${(1 - t * 0.24).toFixed(3)})`;
        card.style.filter = `saturate(${(1 - t * 0.5).toFixed(2)})`;
        card.style.pointerEvents = o < 0.12 ? 'none' : '';
      }

      // Whichever spoke is nearest top dead centre owns the read-out.
      let i = Math.round(-rot / step) % n;
      if (i < 0) i += n;
      show(i);
    };

    const tick = () => {
      draw();
      raf = visible ? requestAnimationFrame(tick) : 0;
    };

    const start = () => { if (!raf && visible) raf = requestAnimationFrame(tick); };

    // Frames are only requested while the wheel is on screen.
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) { fitArc(); start(); }
    }, { rootMargin: '10% 0px' }).observe(track);

    // Tabbing to a card turns the wheel to it, so the keyboard path shows the
    // same thing the pointer path does rather than focusing a card buried
    // under the mask.
    spokes.forEach((spoke, i) => {
      spoke.querySelector('.card')?.addEventListener('focus', () => {
        if (reduced.matches) return;
        window.scrollTo({ top: scrollFor(i), behavior: 'smooth' });
      });
    });

    let resizeT;
    window.addEventListener('resize', () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(() => { fitArc(); draw(); }, 120);
    });

    const apply = () => {
      if (reduced.matches) {
        if (raf) { cancelAnimationFrame(raf); raf = 0; }
        ring.style.removeProperty('--arc');
        cards.forEach((c) => { c.style.cssText = ''; });
        spokes.forEach((sp, k) => sp.style.setProperty('--a', k * step + 'deg'));
        spokes.forEach((s) => s.classList.remove('is-active'));
        reads.forEach((el) => el.setAttribute('hidden', ''));
        ticks.forEach((t) => t.setAttribute('aria-current', 'false'));
        active = -1;
      } else {
        fitArc();
        start();
      }
    };
    reduced.addEventListener('change', apply);
    apply();
  }
</script>
