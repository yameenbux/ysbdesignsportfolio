---
/**
 * The four working diagrams on engineering.html.
 *
 * Each one is a *mechanism*, not an illustration: you press a button and the
 * thing the copy describes actually happens in front of you. That is what
 * earns them a place under CLAUDE.md's "motion that does not describe
 * structure" ban — the motion here IS the explanation, and a reader who
 * watches the second booking bounce has understood a race condition without
 * being told what one is.
 *
 * Colour discipline, because this is where it would be easiest to drift:
 *   ink / ink-2  structure and type
 *   blue         the thing currently selected or the path that succeeded
 *   signal       refused, failed, or the bug
 * No third colour, no fill that is not one of the palette's own values.
 * Blue and signal are used here as *status*, which is the job the palette
 * already gives them — signal is "live indicators, the one warm note" and
 * blue is the active state on the wheel.
 *
 * Accessibility: every control is a real <button>, every stage has an
 * aria-live status line that says in words what the animation shows, and
 * under prefers-reduced-motion the diagrams jump straight to their end state
 * with no transition. Nothing here is colour-alone — every state is labelled.
 */
const { kind } = Astro.props;
---

{kind === 'gate' && (
  <figure class="mech" data-mech="gate">
    <figcaption class="mech-cap">
      <span class="eyebrow m-0">Try it</span>
      <p>
        Before an app update can be built for the store, a check asks: has
        this <em>exact</em> version already been run and seen to start? If the
        answer is no, it refuses — even if everything else passed.
      </p>
    </figcaption>

    <div class="stage gate-stage">
      <ol class="track" aria-hidden="true">
        <li class="stop"><span class="dot"></span><span class="stop-l">Commit</span></li>
        <li class="stop"><span class="dot"></span><span class="stop-l">Build</span></li>
        <li class="stop is-gate"><span class="dot"></span><span class="stop-l">The gate</span></li>
        <li class="stop"><span class="dot"></span><span class="stop-l">Store</span></li>
      </ol>
      <div class="rail" aria-hidden="true"><span class="token" data-token></span></div>
    </div>

    <div class="mech-do">
      <button type="button" class="btn-sm" data-run="pass">Send a version that was tested</button>
      <button type="button" class="btn-sm" data-run="fail">Send one that was not</button>
    </div>
    <p class="mech-out" data-out role="status" aria-live="polite">Press a button to send a version down the pipeline.</p>
    <p class="mech-src">Really runs as <strong>native-release.yml</strong> — it asks the GitHub API for a successful smoke run at this commit's own <code>head_sha</code>, and exits non-zero when the count is zero.</p>
  </figure>
)}

{kind === 'tenancy' && (
  <figure class="mech" data-mech="tenancy">
    <figcaption class="mech-cap">
      <span class="eyebrow m-0">Try it</span>
      <p>
        Every masjid's information sits in <em>one</em> database. Each row
        knows which masjid it belongs to, and the database — not the app —
        decides what you are allowed to see. Sign in as someone else and watch
        the rows disappear.
      </p>
    </figcaption>

    <div class="stage">
      <ul class="rows-db" data-rows>
        <li data-owner="A"><span class="tag">Masjid A</span><span class="rw">Prayer timetable</span></li>
        <li data-owner="B"><span class="tag">Masjid B</span><span class="rw">Madrasah register</span></li>
        <li data-owner="A"><span class="tag">Masjid A</span><span class="rw">Hall booking</span></li>
        <li data-owner="C"><span class="tag">Masjid C</span><span class="rw">Gift Aid record</span></li>
        <li data-owner="B"><span class="tag">Masjid B</span><span class="rw">Donation</span></li>
        <li data-owner="A"><span class="tag">Masjid A</span><span class="rw">Notice</span></li>
      </ul>
    </div>

    <div class="mech-do" role="group" aria-label="Choose who is signed in">
      <button type="button" class="btn-sm" data-as="A" aria-pressed="false">Sign in as Masjid A</button>
      <button type="button" class="btn-sm" data-as="B" aria-pressed="false">Masjid B</button>
      <button type="button" class="btn-sm" data-as="C" aria-pressed="false">Masjid C</button>
    </div>
    <p class="mech-out" data-out role="status" aria-live="polite">Nobody is signed in, so no rows are readable.</p>
    <p class="mech-src">Every table carries a <code>masjid_id</code> that is <code>not null</code> with no default. Row Level Security scopes each read; the app never gets to ask for someone else's rows.</p>
  </figure>
)}

{kind === 'race' && (
  <figure class="mech" data-mech="race">
    <figcaption class="mech-cap">
      <span class="eyebrow m-0">Try it</span>
      <p>
        Two clients tap the same 9am slot at the same moment. Both are told it
        is free — because at the instant they looked, it was. Only one of them
        can actually have it, and the database is what settles the argument.
      </p>
    </figcaption>

    <div class="stage race-stage">
      <div class="lane" data-lane="1">
        <span class="eyebrow m-0">Phone one</span>
        <ol class="steps">
          <li data-s="ask">Is 09:00 free?</li>
          <li data-s="said">Told: yes, it's free</li>
          <li data-s="write">Write the booking</li>
        </ol>
        <p class="verdict">&nbsp;</p>
      </div>
      <div class="lane" data-lane="2">
        <span class="eyebrow m-0">Phone two</span>
        <ol class="steps">
          <li data-s="ask">Is 09:00 free?</li>
          <li data-s="said">Told: yes, it's free</li>
          <li data-s="write">Write the booking</li>
        </ol>
        <p class="verdict">&nbsp;</p>
      </div>
    </div>

    <div class="mech-do">
      <button type="button" class="btn-sm" data-run="race">Both tap 09:00 at once</button>
      <button type="button" class="btn-sm btn-sm-q" data-run="reset">Reset</button>
    </div>
    <p class="mech-out" data-out role="status" aria-live="polite">Press the button to let both phones try at the same time.</p>
    <p class="mech-src">Checking "is it free?" in app code only narrows the gap between the check and the write. The rule is an <code>EXCLUDE USING gist</code> constraint over the studio and the time range, so the second write raises <code>23P01</code> and rolls back by itself. Cancelling frees the slot, because cancelled rows sit outside the constraint.</p>
  </figure>
)}

{kind === 'burst' && (
  <figure class="mech" data-mech="burst">
    <figcaption class="mech-cap">
      <span class="eyebrow m-0">Try it</span>
      <p>
        A week of prayer reminders should land one at a time, over seven days.
        Because of a single missing word, every one of them was delivered the
        instant it was set — and the screen still said they were scheduled.
      </p>
    </figcaption>

    <div class="stage burst-stage">
      <ol class="days" data-days>
        {['Now', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'].map((d) => (
          <li><span class="pile" data-pile></span><span class="day-l">{d}</span></li>
        ))}
      </ol>
    </div>

    <div class="mech-do" role="group" aria-label="Choose which version to run">
      <button type="button" class="btn-sm" data-run="bug" aria-pressed="false">Arm a week — with the bug</button>
      <button type="button" class="btn-sm" data-run="fixed" aria-pressed="false">Arm a week — fixed</button>
    </div>
    <p class="mech-out" data-out role="status" aria-live="polite">Press a button to arm a week of reminders.</p>
    <p class="mech-src">The library matches a trigger on its <code>type</code> field and drops anything it does not recognise through to a default of <code>null</code> — and a null trigger does not mean <em>never</em>, it means <em>deliver it now</em>. The old shape was accepted silently, so all thirty-six were spent at once and not one was ever really scheduled.</p>
  </figure>
)}

<style>
  /* ---- shared shell ------------------------------------------------- */
  .mech {
    margin: 26px 0 0;
    padding: 22px;
    background: var(--color-plane);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
  }
  .mech-cap { margin: 0 0 18px; }
  .mech-cap p { margin: 8px 0 0; max-width: 60ch; color: var(--color-ink-2); }
  .mech-cap em { font-style: normal; font-weight: 600; color: var(--color-ink); }

  .stage {
    padding: 20px 16px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
  }

  .mech-do { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; }

  .btn-sm {
    font-family: var(--font-disp);
    font-size: 14px; font-weight: 600; line-height: 1;
    padding: 10px 14px; cursor: pointer;
    color: var(--color-plane); background: var(--color-ink);
    border: 1px solid var(--color-ink); border-radius: var(--radius-sm);
    transition: background 160ms var(--ease-turn), color 160ms var(--ease-turn);
  }
  .btn-sm:hover { background: var(--color-blue); border-color: var(--color-blue); }
  .btn-sm[aria-pressed='true'] { background: var(--color-blue); border-color: var(--color-blue); }
  /* In the burst the selected option may be the BUG, so a blue "pressed"
     would have blue meaning both "chosen" and "this one worked" in the same
     diagram. Selected is neutral here; the bar colour carries the verdict. */
  [data-mech='burst'] .btn-sm[aria-pressed='true'] {
    background: var(--color-ink-2); border-color: var(--color-ink-2);
  }
  .btn-sm-q { color: var(--color-ink); background: transparent; }
  .btn-sm-q:hover { color: var(--color-plane); }

  .mech-out {
    margin: 14px 0 0; font-size: 15px; font-weight: 600; color: var(--color-ink);
    min-height: 1.6em;
  }
  .mech-out[data-tone='ok'] { color: var(--color-blue); }
  .mech-out[data-tone='no'] { color: var(--color-signal); }

  .mech-src {
    margin: 12px 0 0; padding: 12px 0 0; font-size: 14px; line-height: 1.6;
    color: var(--color-ink-2); border-top: 1px solid var(--color-line-2);
  }

  /* ---- the gate ------------------------------------------------------ */
  .gate-stage { padding-bottom: 12px; }
  .track { display: flex; justify-content: space-between; margin: 0 0 10px; padding: 0; list-style: none; }
  .stop { display: flex; flex-direction: column; align-items: center; gap: 7px; flex: 1; }
  .stop .dot {
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--color-paper); border: 2px solid var(--color-ink-2);
  }
  .stop.is-gate .dot { border-color: var(--color-ink); border-width: 3px; width: 15px; height: 15px; }
  .stop-l { font-size: 12px; font-weight: 600; color: var(--color-ink-2); text-align: center; }
  .stop.is-gate .stop-l { color: var(--color-ink); }

  .rail { position: relative; height: 4px; margin: 0 0 6px; background: var(--color-line-2); border-radius: 2px; }
  .token {
    position: absolute; top: 50%; left: 12.5%; width: 14px; height: 14px; border-radius: 50%;
    background: var(--color-ink); transform: translate(-50%, -50%) scale(0);
    transition: left 900ms var(--ease-turn), background 220ms linear, transform 220ms var(--ease-turn);
  }
  .token[data-at='start'] { left: 12.5%; transform: translate(-50%, -50%) scale(1); }
  .token[data-at='build'] { left: 37.5%; transform: translate(-50%, -50%) scale(1); }
  .token[data-at='gate']  { left: 62.5%; transform: translate(-50%, -50%) scale(1); }
  .token[data-at='store'] { left: 87.5%; transform: translate(-50%, -50%) scale(1); background: var(--color-blue); }
  .token[data-at='stuck'] { left: 62.5%; transform: translate(-50%, -50%) scale(1); background: var(--color-signal); }

  /* ---- tenancy ------------------------------------------------------- */
  .rows-db { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .rows-db li {
    display: flex; align-items: center; gap: 12px; padding: 10px 12px;
    background: var(--color-plane); border: 1px solid var(--color-line);
    border-radius: var(--radius-sm); font-size: 15px;
    transition: opacity 260ms var(--ease-turn), border-color 260ms var(--ease-turn);
  }
  .rows-db .tag {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-ink-2); white-space: nowrap;
  }
  .rows-db li[data-vis='yes'] { border-color: var(--color-blue); }
  .rows-db li[data-vis='yes'] .tag { color: var(--color-blue); }
  .rows-db li[data-vis='no'] { opacity: 0.38; }
  .rows-db li[data-vis='no'] .rw { text-decoration: line-through; }
  .rows-db li[data-vis='no']::after {
    content: 'hidden by the database'; margin-left: auto;
    font-size: 11px; font-weight: 600; color: var(--color-ink-2);
  }
  .rows-db li[data-vis='yes']::after {
    content: 'readable'; margin-left: auto;
    font-size: 11px; font-weight: 600; color: var(--color-blue);
  }

  /* ---- the race ------------------------------------------------------ */
  .race-stage { display: grid; gap: 14px; }
  @media (min-width: 620px) { .race-stage { grid-template-columns: 1fr 1fr; } }
  .lane { padding: 14px; background: var(--color-plane); border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
  .steps { margin: 10px 0 0; padding: 0 0 0 18px; display: grid; gap: 7px; font-size: 14px; color: var(--color-ink-2); }
  .steps li { opacity: 0.32; transition: opacity 220ms var(--ease-turn), color 220ms var(--ease-turn); }
  .steps li[data-on='1'] { opacity: 1; color: var(--color-ink); }
  .verdict { margin: 12px 0 0; min-height: 1.5em; font-size: 14px; font-weight: 700; }
  .verdict[data-v='won'] { color: var(--color-blue); }
  .verdict[data-v='lost'] { color: var(--color-signal); }

  /* ---- the notification burst ---------------------------------------- */
  .days { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; align-items: end; }
  .days li { display: flex; flex-direction: column; align-items: center; gap: 7px; }
  .pile {
    display: block; width: 100%; max-width: 34px; height: 0; border-radius: 2px;
    background: var(--color-ink-2);
    transition: height 420ms var(--ease-turn), background 220ms linear;
  }
  .days li:first-child .pile[data-tone='no'] { background: var(--color-signal); }
  .pile[data-tone='ok'] { background: var(--color-blue); }
  .day-l { font-size: 11px; font-weight: 600; color: var(--color-ink-2); text-align: center; }
  .burst-stage { min-height: 150px; display: flex; align-items: flex-end; }
  .burst-stage .days { width: 100%; }

  @media (prefers-reduced-motion: reduce) {
    .token, .rows-db li, .steps li, .pile { transition: none !important; }
  }
</style>

<script>
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Under reduced motion every step lands immediately: the diagrams still
  // tell the whole story, they just do not animate getting there.
  const wait = (ms) => new Promise((r) => setTimeout(r, RM.matches ? 0 : ms));
  const say = (el, text, tone) => {
    const out = el.querySelector('[data-out]');
    out.textContent = text;
    if (tone) out.setAttribute('data-tone', tone); else out.removeAttribute('data-tone');
  };

  // ---- the release gate ------------------------------------------------
  document.querySelectorAll('[data-mech="gate"]').forEach((el) => {
    const token = el.querySelector('[data-token]');
    let running = false;
    el.querySelectorAll('[data-run]').forEach((b) => b.addEventListener('click', async () => {
      if (running) return;
      running = true;
      const ok = b.dataset.run === 'pass';
      token.dataset.at = 'start';
      say(el, ok ? 'Sent a version that has already been run and seen to start…' : 'Sent a version nothing has run yet…');
      await wait(420); token.dataset.at = 'build';
      await wait(900); token.dataset.at = 'gate';
      await wait(900);
      if (ok) {
        token.dataset.at = 'store';
        say(el, 'The gate found a successful run at this exact version. It builds.', 'ok');
      } else {
        token.dataset.at = 'stuck';
        say(el, 'Refused. Nothing has ever run this version, so the gate will not build it — however green everything else looked.', 'no');
      }
      running = false;
    }));
  });

  // ---- one database, many organisations --------------------------------
  document.querySelectorAll('[data-mech="tenancy"]').forEach((el) => {
    const rows = [...el.querySelectorAll('[data-rows] li')];
    el.querySelectorAll('[data-as]').forEach((b) => b.addEventListener('click', () => {
      const who = b.dataset.as;
      el.querySelectorAll('[data-as]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      let seen = 0;
      rows.forEach((r) => {
        const vis = r.dataset.owner === who;
        if (vis) seen++;
        r.dataset.vis = vis ? 'yes' : 'no';
      });
      say(el, `Signed in as Masjid ${who}. ${seen} of ${rows.length} rows are readable — the other ${rows.length - seen} are refused by the database, not hidden by the page.`, 'ok');
    }));
  });

  // ---- the double booking ----------------------------------------------
  document.querySelectorAll('[data-mech="race"]').forEach((el) => {
    const lanes = [...el.querySelectorAll('.lane')];
    let running = false;
    const reset = () => {
      el.querySelectorAll('.steps li').forEach((s) => (s.dataset.on = '0'));
      lanes.forEach((l) => { const v = l.querySelector('.verdict'); v.textContent = ' '; v.removeAttribute('data-v'); });
      say(el, 'Press the button to let both phones try at the same time.');
    };
    el.querySelectorAll('[data-run]').forEach((b) => b.addEventListener('click', async () => {
      if (b.dataset.run === 'reset') { if (!running) reset(); return; }
      if (running) return;
      running = true; reset();
      for (const step of ['ask', 'said', 'write']) {
        lanes.forEach((l) => (l.querySelector(`[data-s="${step}"]`).dataset.on = '1'));
        if (step === 'said') say(el, 'Both were told the slot is free — and at the instant each of them looked, it was.');
        await wait(760);
      }
      const [a, b2] = lanes.map((l) => l.querySelector('.verdict'));
      a.textContent = 'Booked.'; a.dataset.v = 'won';
      b2.textContent = 'Refused — 23P01, rolled back.'; b2.dataset.v = 'lost';
      say(el, 'The database refused the second write itself. Nobody had to remember to check, and the client is told straight away rather than turning up to a taken slot.', 'ok');
      running = false;
    }));
  });

  // ---- the notification burst ------------------------------------------
  document.querySelectorAll('[data-mech="burst"]').forEach((el) => {
    const piles = [...el.querySelectorAll('[data-pile]')];
    const MAX = 108; // px for the tallest pile — 36 on one day
    let running = false;
    el.querySelectorAll('[data-run]').forEach((b) => b.addEventListener('click', async () => {
      if (running) return;
      running = true;
      const bug = b.dataset.run === 'bug';
      el.querySelectorAll('[data-run]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      piles.forEach((p) => { p.style.height = '0px'; p.removeAttribute('data-tone'); });
      await wait(120);
      if (bug) {
        piles[0].style.height = MAX + 'px';
        piles[0].dataset.tone = 'no';
        say(el, 'All thirty-six arrived at once, now. The queue is empty — not one was really scheduled — and the settings screen still reported "36 reminders are scheduled on this phone".', 'no');
      } else {
        piles.forEach((p, i) => { p.style.height = Math.round(MAX / 7) + 'px'; p.dataset.tone = 'ok'; void i; });
        say(el, 'Five or six a day across seven days, each one arriving when it is wanted. The triggers are built in a file a plain test can read, and one test asserts the library still behaves the way the comment says.', 'ok');
      }
      running = false;
    }));
  });
</script>
