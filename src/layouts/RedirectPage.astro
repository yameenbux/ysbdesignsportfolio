---
/**
 * A retired URL that forwards to its replacement.
 *
 * Every address this site has published stays reachable — CLAUDE.md has
 * promised that since Phase 4 — so a renamed project leaves its old URL
 * behind rather than 404ing it.
 *
 * Written as a real page rather than an `astro.config` redirect because that
 * config emits NOTHING for a literal `.html` route under `build.format:
 * 'file'`, and still reports the build as a success. A page is checkable: it
 * either lands in dist/ or the build shows it did not.
 *
 * `noindex,follow` so the old address drops out of the index while the link
 * equity still reaches the new one. Canonical points at the destination.
 *
 * These pages navigate away mid-check, which a headless sweep reads as an
 * error — skip them by filename when sweeping, don't "fix" the meta refresh.
 */
const { to, title, body, linkText } = Astro.props;
const CANONICAL = `https://www.ysbdesigns.uk${to}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — YSB Designs</title>
    <link rel="canonical" href={CANONICAL} />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center;
             background: #E8E6DE; color: #16191C; padding: 24px;
             font: 17px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
      h1 { font-size: 1.3rem; font-weight: 600; margin: 0 0 8px; }
      a { color: #1F45CC; }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Taking you to <a href={to}>{linkText}</a>.</p>
      <slot />
    </main>
  </body>
</html>
