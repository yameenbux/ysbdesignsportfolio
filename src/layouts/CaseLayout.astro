---
import BaseLayout from './BaseLayout.astro';

/**
 * One template behind all six case studies. Content comes from
 * src/data/cases.js; nothing here is per-project.
 *
 * Problem → approach → outcome, then the screens, per the copy rule in
 * CLAUDE.md. Screenshots are the hero content, so the copy above them
 * exists to explain what the visitor is looking at.
 */
const { data } = Astro.props;
const { title, kind, role, problem, approach, outcome, links, shots, description } = data;

const sections = [['Problem', problem], ['Approach', approach], ['Outcome', outcome]];
---

<BaseLayout title={title} description={description}>
  <p class="pt-10">
    <a href="/work.html" class="label no-underline transition-colors duration-150 hover:text-blue">← All work</a>
  </p>

  <section class="mt-8">
    <p class="label label-blue m-0">{kind}</p>
    <h1 class="mt-4 text-[clamp(2.4rem,5.6vw,4rem)] font-extrabold leading-[1] tracking-[-0.03em] [font-variation-settings:'wdth'_112]">
      {title}
    </h1>
  </section>

  <div class="mt-12 grid grid-cols-1 gap-x-9 gap-y-10 lg:grid-cols-12">
    <aside class="lg:col-span-3">
      <p class="label m-0 normal-case tracking-normal">{role}</p>

      {links.length > 0 && (
        <ul class="mt-6 flex list-none flex-col gap-2 p-0">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener"
                 class="label label-ink underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-blue hover:decoration-blue">{l.text} ↗</a>
            </li>
          ))}
        </ul>
      )}
    </aside>

    <div class="lg:col-span-9">
      <dl class="m-0 space-y-8">
        {sections.map(([label, copy]) => (
          <div>
            <dt class="label m-0">{label}</dt>
            <dd class="measure m-0 mt-2 text-ink-2 [&_strong]:font-medium [&_strong]:text-ink" set:html={copy} />
          </div>
        ))}
      </dl>
    </div>
  </div>

  <section class="mt-20 border-t border-line py-16">
    <h2 class="rv label m-0">The screens</h2>

    <div class="mt-10 grid grid-cols-1 gap-x-9 lg:grid-cols-12">
      <div class="flex flex-col gap-14 lg:col-span-9 lg:col-start-4">
        {shots.map((s) => (
          <figure class="rv m-0">
            <div class="sheet overflow-hidden" class:list={[s.portrait && 'max-w-[300px]']}>
              <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async"
                   class="block h-auto w-full" />
            </div>
            <figcaption class="label mt-3">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-line py-24">
    <h2 class="rv text-[clamp(1.5rem,3vw,2.1rem)] font-bold tracking-[-0.02em]">If this looks like your problem</h2>
    <p class="rv measure mt-6 text-ink-2">Tell me about it and I'll tell you what it takes.</p>
    <div class="rv mt-8 flex flex-wrap items-center gap-3.5">
      <a class="btn" href="https://wa.me/447404901859" target="_blank" rel="noopener">Message me on WhatsApp</a>
      <a class="btn btn-ghost" href="/work.html">See the other projects</a>
    </div>
  </section>
</BaseLayout>
