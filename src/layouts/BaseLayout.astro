---
import '../styles/global.css';

/**
 * The shell every page sits in.
 *
 * v3 puts the masthead over the ground rather than on a ruled band, and the
 * footer on the one step-down colour (field-2) so the page ends on a shade
 * rather than a line. Colour bands are this direction's separator; there are
 * no hairline rules anywhere on the site.
 *
 * Two contact routes, both the same number. No email (there is no mailbox)
 * and no social profile — see CLAUDE.md, "## Contact".
 */

const {
  title,
  description = "I build the whole thing for new and growing businesses — the website, the software behind it and the hosting it runs on, designed and deployed by one person.",
  noindex = false,
  wide = false,
} = Astro.props;

const nav = [
  { href: '/work.html',    label: 'Work' },
  { href: '/about.html',   label: 'About' },
  { href: '/contact.html', label: 'Contact' },
];

const path = Astro.url.pathname;
const isCurrent = (href) => path === href;

// build.format 'file' makes the homepage's pathname '/index.html'. Canonical
// to the bare domain: they are the same page, and the short one is what
// people link to.
const canonicalPath = path === '/index.html' ? '/' : path;
const canonical = new URL(canonicalPath, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();

const WHATSAPP = '447404901859';
const TEL = '+447404901859';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — YSB Designs` : 'YSB Designs'}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1B2CC4" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? 'YSB Designs'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="YSB Designs" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YSB Designs — the site, the software behind it and the hosting it runs on" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? 'YSB Designs'} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Self-hosted, same origin — no render-blocking third-party stylesheet
        and no third party learning who visits. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/karla-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/syne-latin.woff2" crossorigin />

    {/* Set before paint so reveal elements are never hidden without a script
        able to reveal them again. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class="shell mast">
      <a href="/" class="wordmark">YSB<span>Designs</span></a>
      <nav aria-label="Primary">
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={['eyebrow navlink', isCurrent(item.href) && 'is-current']}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class:list={[!wide && 'shell']}>
      <slot />
    </main>

    <footer class="foot">
      <div class="shell foot-in">
        <div>
          <p class="foot-mark">Let's build it.</p>
          <p class="foot-routes">
            <a class="ul-draw" href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener">WhatsApp</a>
            <a class="ul-draw" href={`tel:${TEL}`}>07404 901859</a>
          </p>
        </div>
        <div class="foot-meta">
          <p class="eyebrow m-0">© {year} YSB Designs · Greater Manchester</p>
          <p class="foot-legal">
            <a class="eyebrow ul-draw" href="/privacy.html">Privacy</a>
            <a class="eyebrow ul-draw" href="/terms.html">Terms</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      // One observer for the page; each element is unobserved once shown, so
      // this costs nothing after first paint.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }
      }, { rootMargin: '0px 0px -10% 0px' });

      document.querySelectorAll('.rv').forEach((el, i) => {
        el.style.transitionDelay = `${(i % 4) * 80}ms`;
        io.observe(el);
      });
    </script>
  </body>
</html>

<style is:global>
  .shell { max-width: 1220px; margin-inline: auto; padding-inline: 28px; }

  .skip {
    position: absolute;
    width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
    background: var(--color-blue); color: var(--color-ink);
    font-weight: 700; padding: 12px 18px; z-index: 90;
    border-radius: var(--radius-sm);
  }
  .skip:focus {
    left: 16px; top: 16px;
    width: auto; height: auto; overflow: visible;
    clip-path: none;
  }

  .mast {
    display: flex; align-items: center; justify-content: space-between;
    gap: 32px; padding-block: 26px 8px;
  }
  .wordmark {
    font-family: var(--font-disp); font-weight: 800; font-size: 19px;
    letter-spacing: -0.03em; text-decoration: none; color: var(--color-ink);
  }
  .wordmark span { color: var(--color-ink-2); font-weight: 500; margin-left: 6px; }
  .mast nav ul { display: flex; gap: 26px; margin: 0; padding: 0; list-style: none; }
  .navlink { text-decoration: none; transition: color 0.2s; }
  .navlink:hover { color: var(--color-blue); }
  .navlink.is-current { color: var(--color-ink); }

  .foot { background: var(--color-paper-2); margin-top: 0; }
  .foot-in {
    display: flex; flex-wrap: wrap; gap: 36px;
    align-items: flex-end; justify-content: space-between;
    padding-block: 60px 46px;
  }
  .foot-mark {
    font-family: var(--font-disp); font-weight: 800;
    font-size: clamp(1.7rem, 4vw, 2.6rem); letter-spacing: -0.03em;
    margin: 0; line-height: 1;
  }
  .foot-routes { margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 22px; font-size: 16px; }
  .foot-meta { text-align: right; }
  .foot-legal { margin: 8px 0 0; display: flex; gap: 18px; justify-content: flex-end; }

  @media (max-width: 640px) {
    .shell { padding-inline: 20px; }
    .mast { flex-direction: column; align-items: flex-start; gap: 14px; }
    .mast nav ul { gap: 20px; }
    .foot-meta { text-align: left; }
    .foot-legal { justify-content: flex-start; }
  }

  .m-0 { margin: 0; }
</style>
